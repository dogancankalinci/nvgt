/**
	Returns the total number of keys that are currently held down or have been released without the release having been read yet.
	int total_keys_down();
	## Returns:
		int: the number of keys held down now, plus the number of keys released whose release key_released() hasn't reported yet.
	## Remarks:
		This function includes not only keys that are currently being held down, but also keys that have been released and whose release hasn't been read yet: a released key stays in the count until key_released() (or keys_released()) reports its release, or it is pressed again, however many frames that takes. Its purpose is to reduce the workflow of keyboard configuration systems that want to detect how many keys to monitor, including key releases.
*/

// Example:
void main() {
	int check_time = 1000, orig_ticks = ticks();
	show_window("Example");
	while (true) {
		wait(5);
		if ((ticks() - orig_ticks) >= check_time) {
			orig_ticks = ticks();
			int key_count  = total_keys_down();
			screen_reader_output(key_count + " " + (key_count == 1 ? "key is" : "keys are") + " currently held down.", true);
		}
		if (key_pressed(KEY_ESCAPE))
			exit();
	}
}
