/**
	Completely shut down your application, returning a particular exit code to your operating system in the process.
	void exit(int exit_code = 0);
	## Arguments:
		* int exit_code = 0: the exit code to return to your operating system.
	## Remarks:
		Called from preglobals() or while global variables are being initialized, the script ends before main() runs. Called once main() has returned, from on_exit(), a destructor or a thread still running, the rest of the shutdown still happens, and the program ends with the code given.
*/

// Example:
void main() {
	show_window("Example");
	screen_reader_output("Press escape to exit.", true);
	while (true) {
		wait(5);
		if (key_pressed(KEY_ESCAPE)) {
			screen_reader_output("Goodbye.", true);
			wait(500);
			exit();
		}
	}
}
