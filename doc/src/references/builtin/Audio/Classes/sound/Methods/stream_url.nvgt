/**
	Load the specified URL.
	bool sound::stream_url(const string&in url);
	## Arguments:
		* string url: the URL to load (should be the direct link to a sound or stream).
	## Returns:
		Bool: True if the URL was successfully loaded; false otherwise.
	## Remarks:
		This function should currently be considered beta.

		It waits for the server's connection and the stream's first pages, so it is refused with AUDIO_ERROR_STATE_INVALID_OPERATION in an engine's processing_callback, whose device would wait as long.
*/

// Example:
void main() {
	sound s;
	bool success = s.stream_url("https://example.com/my_sound.mp3");
	alert("Result", "The sound is " + (success == false? "not " : "") + "ready to stream.");
}
