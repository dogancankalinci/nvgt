/**
	reports whether NVGT's screen reader support could be loaded.
	const bool SCREEN_READER_AVAILABLE;
	## Remarks:
		This doesn't tell whether a screen reader is running; use screen_reader_has_speech() or screen_reader_detect() for that. On Linux, where Speech Dispatcher stands in for a screen reader, it is true while Speech Dispatcher has voices.
*/

// Example:
void main() {
	if (SCREEN_READER_AVAILABLE)
		alert("Info", "Screen reader support is available.");
	else
		alert("Info", "Screen reader support is not available.");
}
