/**
	Get a count of all available text to speech voices, including the builtin.
	int tts_voice::get_voice_count();
	## Returns:
		* int: the number of tts voices.
	## Remarks:
		The voice built into NVGT is counted here whenever the object's engine list includes "fallback", which it does by default, so the count is then one more than the voices of the system's engines. Speech Dispatcher on Linux counts as a single voice.
*/

// Example:
void main() {
	tts_voice v;
	alert("result:", "You have "+v.get_voice_count()+" voices");
}