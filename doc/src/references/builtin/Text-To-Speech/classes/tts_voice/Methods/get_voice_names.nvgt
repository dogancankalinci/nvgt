/**
	List all the available voices of the tts_voice object. This is another name for list_voices, as BGT called it.
	string[]@ tts_voice::get_voice_names();
	## Returns:
		string[]@: a handle to an array containing all the voice names (as strings).
*/

// Example:
void main() {
	tts_voice v;
	alert("Your available text-to-speech voices are", join(v.get_voice_names(), ", "));
}
