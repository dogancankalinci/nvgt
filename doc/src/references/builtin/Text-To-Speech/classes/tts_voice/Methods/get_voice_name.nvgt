/**
	Get the name of a voice at a particular index.
	string tts_voice::get_voice_name(int index);
	## Parameters:
		* int index: the index of the voice to get the name of.
	## Returns:
		string: the name of the voice, or an empty string for an index out of range.
	## Remarks:
		When the object's engine list includes "fallback", which it does by default, voice 0 is the builtin voice.
*/

// Example:
void main() {
	tts_voice v;
	string names;
	for (int i = 0; i < v.voice_count; i++) names += (i > 0? ", " : "") + v.get_voice_name(i);
	alert("Your voices are", names);
}
