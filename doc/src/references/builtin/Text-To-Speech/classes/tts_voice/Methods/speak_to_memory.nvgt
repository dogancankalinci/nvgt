/**
	Synthesizes a string of text through the currently active TTS voice and returns the audio as the contents of a wave file.
	string tts_voice::speak_to_memory(const string&in text);
	## Arguments:
		* const string&in text: the text to synthesize.
	## Returns:
		string: the wave file's contents, or an empty string on failure.
	## Remarks:
		Text with nothing to say, such as punctuation alone, gives a wave file without samples, while empty text fails, as with speak, and gives an empty string. Engines that can't synthesize to memory, such as Speech Dispatcher on Linux, make this return an empty string.
*/

// Example:
void main() {
	tts_voice v;
	string data = v.speak_to_memory("Hello there!");
	if (data.empty()) {
		alert("Error", "The voice could not synthesize to memory.");
		exit();
	}
	alert("Info", "The wave file is " + data.length() + " bytes long.");
}
