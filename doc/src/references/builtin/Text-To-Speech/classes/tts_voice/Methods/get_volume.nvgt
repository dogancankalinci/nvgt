/**
	Get the text to speech voice's volume (how loud it is).
	float tts_voice::get_volume();
	## Returns:
		float: the current volume.
	## Remarks:
		-100 is silent and 0 is loudest, as in BGT. If this hasn't been assigned, it reports the volume the engine starts with, which may not be 0; see volume_set for what that is on each platform. This is the same as reading the volume property.
*/

// Example:
void main() {
	tts_voice v;
	v.set_volume(-50);
	alert("the current volume is: ", ""+v.get_volume());
}
