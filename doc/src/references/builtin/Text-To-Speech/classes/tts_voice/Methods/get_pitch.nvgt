/**
	Get the text to speech voice's pitch.
	float tts_voice::get_pitch();
	## Returns:
		float: the current pitch.
	## Remarks:
		-10 is lowest and 10 is highest, with 0 being the default. If this hasn't been assigned, it reports the pitch the engine uses, which may not be 0. This is the same as reading the pitch property.
*/

// Example:
void main() {
	tts_voice v;
	v.set_pitch(-3);
	alert("the current pitch is: ", "" + v.get_pitch());
}
