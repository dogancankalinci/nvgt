/**
	Set the text to speech voice's volume (how loud it is).
	void tts_voice::set_volume(float volume);
	## Arguments:
		* float volume: the desired volume level.
	## Remarks:
		-100 is silent and 0 is loudest, as in BGT, with -50 being the middle of the engine's range; values outside are clamped to it. If this hasn't been assigned, it will use the OS setting which may not be 0. This is the same as assigning the volume property.
*/

// Example:
void main() {
	tts_voice v;
	v.set_volume(-50);
	v.speak("This is at -50 volume");
	v.set_volume(0);
	v.speak_wait("this is at full volume");
}
