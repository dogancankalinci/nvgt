/**
	Cancels any request in progress and clears its results, and with configuration set, puts every setting back as well, to the state the http object was in at the time of it's construction.
	void reset(bool configuration = false);
	## Arguments:
		* bool configuration = false: also set max_retries, retry_delay, keepalive, the timeouts and the user agent back to their defaults.
	## Remarks:
		Without configuration the settings stay as the script set them. Every request method calls reset() first, so a request's results never mix with the last one's.
		This method waits for the current request to cancel successfully, which is usually instant. However from time to time you could see a small delay as the request thread runs to the next point where it can check the cancelation event.
		This method is implicitly called whenever the http object destructs.
*/

// Example:
void main() {
	http h;
	h.get("https://nvgt.dev");
	wait(20);
	h.reset();
	h.get("https://samtupy.com/ip.php");
	h.wait();
	if (h.status_code != 200) alert("oops " + h.status_code, h.response_body);
	else alert("IP address displayed after http reset", h.response_body);
}
