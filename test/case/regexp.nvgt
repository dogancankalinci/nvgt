void test_regexp() {
	// Test search
	assert(regexp_search("hello this is a test", "\\d") == false);  // No digits
	assert(regexp_search("hello 123 test", "\\d") == true);  // Has digits
	assert(regexp_search("test@example.com", "[a-z]+@[a-z]+\\.[a-z]+") == true);
	
	// Test replace
	assert(regexp_replace("this is 1 huge test of 3 numbers", "\\d", "the") == "this is the huge test of the numbers");
	assert(regexp_replace("hello world", "o", "0") == "hell0 w0rld");
	assert(regexp_replace("test123test", "[0-9]+", "-") == "test-test");
	
	// Empty matches before the end are replaced and stepped over instead of hanging; as always, one at the very end is left alone
	assert(regexp_replace("abc", "x*", "-") == "-a-b-c");
	assert(regexp_replace("a b  c", "\\s*", "") == "abc");
	assert(regexp_replace("abc  ", "\\s*$", ".") == "abc.");
	assert(regexp_replace("\u00e7\u011f", "x*", "|") == "|\u00e7|\u011f");
	// A group that took no part in the match inserts nothing
	assert(regexp_replace("b", "(a)|(b)", "<$1>") == "<>");
	assert(regexp_replace("hello world", "(\\w+) (\\w+)", "$2 $1") == "world hello");
	regexp r("x*");
	string s = "axb";
	assert(r.subst(s, "-", RE_GLOBAL | RE_NOT_EMPTY) == 1 && s == "a-b");
	
	// split honours match options
	regexp mail("(\\w+)@(\\w+)");
	string[]@ parts = mail.split("mail bob@host now", 0, RE_NOT_EMPTY);
	assert(parts.length() == 3 && parts[1] == "bob" && parts[2] == "host");
	assert(mail.split("mail bob@host now", 0, RE_ANCHORED).length() == 0);
	assert(mail.split("mail bob@host now", 5, RE_ANCHORED).length() == 3);
	
	// Each newline convention decides where ^ and $ match in multiline mode, and what . doesn't match
	assert(regexp_search("a\rb", "^b", RE_MULTILINE | RE_NEWLINE_CR) && !regexp_search("a\r\nb", "^b", RE_MULTILINE | RE_NEWLINE_CR));
	assert(regexp_search("a\nb", "^b", RE_MULTILINE | RE_NEWLINE_LF) && !regexp_search("a\rb", "^b", RE_MULTILINE | RE_NEWLINE_LF));
	assert(regexp_search("a\r\nb", "^b", RE_MULTILINE | RE_NEWLINE_CRLF) && !regexp_search("a\nb", "^b", RE_MULTILINE | RE_NEWLINE_CRLF));
	assert(regexp_search("a\rb", "^b", RE_MULTILINE | RE_NEWLINE_ANY_CRLF) && regexp_search("a\nb", "^b", RE_MULTILINE | RE_NEWLINE_ANY_CRLF) && regexp_search("a\r\nb", "a$", RE_MULTILINE | RE_NEWLINE_ANY_CRLF));
	assert(regexp_replace("x\r\ny\nz", "^", ">", RE_MULTILINE | RE_NEWLINE_CRLF) == ">x\r\n>y\nz");
	assert(regexp_match("a\nb", "a.b") && !regexp_match("a\nb", "a.b", RE_NEWLINE_LF));
	regexp crlf("^b", regexp_options(RE_MULTILINE | RE_NEWLINE_CRLF));
	assert(crlf.extract("a\r\nb") == "b" && crlf.extract("a\nb") == "");
}