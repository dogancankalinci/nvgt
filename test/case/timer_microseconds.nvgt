void test_timer_microseconds() {
	timer t(0, 1);
	wait(1);
	assert(t.has_elapsed(900));
	// wait(1) can take a whole time slice or more on a busy machine, so the bound only rules out a wrong unit such as nanoseconds.
	assert(t.elapsed < 500 * MILLISECONDS);
	t.pause();
	int64 old = t.elapsed;
	wait(1);
	assert(t.elapsed == old);
	t.resume();
	assert(t.has_elapsed(old));
	t.force(10 * SECONDS);
	t.restart();
	assert(t.elapsed < 500 * MILLISECONDS);
	t.force(2 * SECONDS);
	assert(t.has_elapsed(2 * SECONDS));
	assert(!t.has_elapsed(2 * SECONDS + 1 * MILLISECONDS));
	t.adjust(-1 * SECONDS);
	assert(t.has_elapsed(1 * SECONDS));
	assert(!t.has_elapsed(1 * SECONDS + 1 * MILLISECONDS));
}
