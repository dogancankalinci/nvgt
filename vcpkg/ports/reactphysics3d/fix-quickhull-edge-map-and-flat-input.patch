+// Give an half-edge other end vertices
+/// The map from a pair of vertices to its edge is what links a new face to its neighbors, so it has to follow
+/// the change.
+void QHHalfEdgeStructure::setEdgeVertices(Edge* edge, Vertex* startVertex, Vertex* endVertex) {
+
+    if (mMapVerticesToEdge.containsKey(EdgeVertices(edge->startVertex, edge->endVertex))) {
+        mMapVerticesToEdge.remove(EdgeVertices(edge->startVertex, edge->endVertex));
+    }
+    else {
+        mIsBroken = true;
+    }
+
+    edge->startVertex = startVertex;
+    edge->endVertex = endVertex;
+
+    if (mMapVerticesToEdge.containsKey(EdgeVertices(startVertex, endVertex))) {
+        mIsBroken = true;
+    }
+    else {
+        mMapVerticesToEdge.add(Pair<EdgeVertices, Edge*>(EdgeVertices(startVertex, endVertex), edge));
+    }
+}
