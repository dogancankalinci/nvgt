+	asSSystemFunctionInterface *sysFunc = descr->sysFuncIntf;
+	const bool autoHandle = sysFunc->paramAutoHandles.GetLength() > last && sysFunc->paramAutoHandles[last];
+	int offset = 0;
+	for( asUINT n = 0; n < last; n++ )
+		offset += descr->parameterTypes[n].GetSizeOnStackDWords();
+	const int size = dt.GetSizeOnStackDWords();
+
+	for( asUINT a = last; a < argCount; a++, offset += size )
+	{
+		void **addr = (void**)&args[offset];
+		if( dt.IsFuncdef() )
+		{
+			if( engine->ep.genericCallMode == 0 || autoHandle )
+			{
+				if( *addr )
+					reinterpret_cast<asCScriptFunction*>(*addr)->Release();
