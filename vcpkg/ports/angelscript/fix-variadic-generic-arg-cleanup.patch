+// ALTERED: the same check for a variadic function, whose arguments follow a count of them (PrepareObjectRefArgs leaves
+// objectRefArgs empty for it): a null reference to an object reached the function as an argument of the variadic
+// parameter or of a fixed one. args points at the first value after the object pointer.
+bool HasNullVariadicObjectRefArg(asCScriptFunction *descr, asDWORD *args)
+{
+	int offset = 0;
+	if( descr->DoesReturnOnStack() )
+		offset += AS_PTR_SIZE;
+	const asUINT argCount = args[offset];
+	offset += 1;
+	for( asUINT a = 0; a < argCount; a++ )
+	{
+		const asUINT n = a < descr->parameterTypes.GetLength() ? a : descr->parameterTypes.GetLength() - 1;
+		asCDataType &dt = descr->parameterTypes[n];
+		if( dt.IsReference() && dt.IsObject() && !dt.IsObjectHandle() && dt.GetTokenType() != ttQuestion &&
+			*(asPWORD*)&args[offset] == 0 )
+			return true;
+		offset += dt.GetSizeOnStackDWords();
+	}
+	return false;
+}
