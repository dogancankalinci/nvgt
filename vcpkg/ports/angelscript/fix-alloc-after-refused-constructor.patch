diff --git a/sdk/angelscript/source/as_callfunc.cpp b/sdk/angelscript/source/as_callfunc.cpp
index 014b7a3..39c0287 100644
--- a/sdk/angelscript/source/as_callfunc.cpp
+++ b/sdk/angelscript/source/as_callfunc.cpp
@@ -319,7 +319,9 @@ void CleanVariadicArgsOfGenericCall(asCScriptEngine *engine, asCScriptFunction *
 // the copy of an object passed by value were never released or freed, as neither the compiled script nor the exception
