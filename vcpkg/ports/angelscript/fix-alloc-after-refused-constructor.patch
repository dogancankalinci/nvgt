-void CleanArgsOfUnmadeCall(asCContext *context, asCScriptFunction *descr, asDWORD *args)
+// ALTERED: returns the size of what it walked, for CallSystemFunction and CallGeneric to return as the size of what the call
+// took off the stack, see there.
+int CleanArgsOfUnmadeCall(asCContext *context, asCScriptFunction *descr, asDWORD *args)
 {
 	asCScriptEngine *engine = context->m_engine;
 	int offset = 0;
@@ -366,6 +368,7 @@ void CleanArgsOfUnmadeCall(asCContext *context, asCScriptFunction *descr, asDWOR
 		}
 		offset += dt.GetSizeOnStackDWords();
 	}
+	return offset;
 }
 
 // This function should prepare system functions so that it will be faster to call them
@@ -916,8 +919,7 @@ int CallSystemFunction(int id, asCContext *context)
 			if( obj == 0 )
 			{
 				context->SetInternalException(TXT_NULL_POINTER_ACCESS);
-				CleanArgsOfUnmadeCall(context, descr, args + AS_PTR_SIZE);
-				return 0;
+				return AS_PTR_SIZE + CleanArgsOfUnmadeCall(context, descr, args + AS_PTR_SIZE); // ALTERED: see below
 			}
 
 			// Skip the object pointer
@@ -971,8 +973,7 @@ int CallSystemFunction(int id, asCContext *context)
 			if( tempPtr == 0 )
 			{
 				context->SetInternalException(TXT_NULL_POINTER_ACCESS);
-				CleanArgsOfUnmadeCall(context, descr, args + AS_PTR_SIZE);
-				return 0;
+				return AS_PTR_SIZE + CleanArgsOfUnmadeCall(context, descr, args + AS_PTR_SIZE); // ALTERED: see below
 			}
 
 			// ALTERED: with asCALL_THISCALL_OBJLAST or OBJFIRST the object on the stack is an argument of the auxiliary
@@ -1018,17 +1019,21 @@ int CallSystemFunction(int id, asCContext *context)
 	if( sysFunc->nativeArgsDontFit )
 	{
 		context->SetInternalException(TXT_INVALID_CALLING_CONVENTION);
-		CleanArgsOfUnmadeCall(context, descr, args);
-		return 0;
+		return int(args - context->m_regs.stackPointer) + CleanArgsOfUnmadeCall(context, descr, args); // ALTERED: see below
 	}
 #endif
 
 	// ALTERED: a null reference to an object is refused before anything is taken from the stack, see PrepareObjectRefArgs
+	// ALTERED: a call that isn't made returns the size of the arguments it consumed (the object pointer and what
+	// CleanArgsOfUnmadeCall walked), as a call that is made does. It returned 0, and asBC_ALLOC, which takes the address of
+	// the variable to store the new object in from below the arguments, read it from the slot of the object pointer it had
+	// pushed: the memory of the object (a value type on the heap: a member of a script class, a string copied from a member
+	// declared after it, which its initializer read before it was made) was written and freed and written again, a use after
+	// free, while the variable was left alone. A call that raised an exception takes everything it was given off the stack.
 	if( sysFunc->objectRefArgs.GetLength() && HasNullObjectRefArg(sysFunc, args) )
 	{
 		context->SetInternalException(TXT_NULL_POINTER_ACCESS);
-		CleanArgsOfUnmadeCall(context, descr, args);
-		return 0;
+		return int(args - context->m_regs.stackPointer) + CleanArgsOfUnmadeCall(context, descr, args);
 	}
 
 	if( descr->DoesReturnOnStack() )
