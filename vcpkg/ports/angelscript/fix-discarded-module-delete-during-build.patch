+// ALTERED: a builder (a build, a function or global variable being compiled, bytecode being loaded, or a declaration being
+// parsed for a lookup such as GetTypeInfoByDecl) reads and changes the engine's lists of types, template instances, funcdefs,
+// functions and global properties, and the deletion of a discarded module removes its entries from the same lists. The
+// deletion runs wherever a garbage collection completes (in Execute's automatic collection on any thread, the application's
+// own collection thread) or a module is discarded, and it ran while another thread was building or looking up a declaration:
+// the build read a funcdef or template instance the deletion had just freed (a use after free in asCBuilder::CompleteFuncDef),
+// and both changed the lists at once. Builders and deletions now exclude each other: a deletion is skipped while a builder
+// exists (the discarded modules are deleted by a later collection or discard), and a builder made while a deletion runs on
+// another thread waits for it to end. A deletion runs no script code (the global variables of a discarded module were
+// released when it was discarded), so the wait is short. The thread doing the deletion can make builders (a clean up
+// callback of the application) without waiting for itself.
+void asCScriptEngine::BuilderStarted()
+{
+	void *thread = asCThreadManager::GetLocalData();
+	for(;;)
+	{
+		ACQUIREEXCLUSIVE(engineRWLock);
+		if( deletingModulesThread == 0 || deletingModulesThread == thread )
+		{
+			activeBuilders++;
+			RELEASEEXCLUSIVE(engineRWLock);
+			return;
+		}
+		RELEASEEXCLUSIVE(engineRWLock);
+
+		// The deleting thread holds the critical section until it is done
+		ENTERCRITICALSECTION(deletingModulesCritical);
+		LEAVECRITICALSECTION(deletingModulesCritical);
+	}
+}
+
+asSBuilderRegistration::asSBuilderRegistration(asCScriptEngine *in_engine) : engine(in_engine)
+{
+	engine->BuilderStarted();
+}
+
+asSBuilderRegistration::~asSBuilderRegistration()
+{
+	engine->BuilderEnded();
+}
+
+void asCScriptEngine::BuilderEnded()
+{
+	ACQUIREEXCLUSIVE(engineRWLock);
+	asASSERT( activeBuilders > 0 );
+	if( activeBuilders > 0 )
+		activeBuilders--;
+	RELEASEEXCLUSIVE(engineRWLock);
+}
+
 void asCScriptEngine::DeleteDiscardedModules()
 {
 	// TODO: redesign: Prevent more than one thread from entering this function at the same time.
 	//                 If a thread is already doing the work for the clean-up the other thread should
 	//                 simply return, as the first thread will continue.
+	// ALTERED: done, and not while a builder exists, see BuilderStarted. The engine's own shut down deletes them anyway.
+	// The critical section is taken first (never while holding engineRWLock, which the deletion takes inside): if another
+	// thread is deleting, that one deletes these too.
+	bool claimed = false;
+	if( !shuttingDown )
+	{
+		if( !TRYENTERCRITICALSECTION(deletingModulesCritical) )
+			return;
+		ACQUIREEXCLUSIVE(engineRWLock);
+		if( deletingModulesThread != 0 )
+		{
+			// This thread's own deletion, got here again (the critical section is recursive on Windows), holds the claim
+			RELEASEEXCLUSIVE(engineRWLock);
+			DeleteDiscardedModulesClaimed();
+			LEAVECRITICALSECTION(deletingModulesCritical);
+			return;
+		}
+		if( activeBuilders > 0 )
+		{
+			RELEASEEXCLUSIVE(engineRWLock);
+			LEAVECRITICALSECTION(deletingModulesCritical);
+			return;
+		}
+		deletingModulesThread = asCThreadManager::GetLocalData();
+		RELEASEEXCLUSIVE(engineRWLock);
+		claimed = true;
+	}
+
+	DeleteDiscardedModulesClaimed();
+
+	if( claimed )
+	{
+		ACQUIREEXCLUSIVE(engineRWLock);
+		deletingModulesThread = 0;
+		RELEASEEXCLUSIVE(engineRWLock);
+		LEAVECRITICALSECTION(deletingModulesCritical);
+	}
+}
 
