diff --git a/sdk/angelscript/source/as_atomic.h b/sdk/angelscript/source/as_atomic.h
--- a/sdk/angelscript/source/as_atomic.h
+++ b/sdk/angelscript/source/as_atomic.h
@@ -43,9 +43,40 @@
 #define AS_ATOMIC_H
 
 #include "as_config.h"
+#include <atomic> // ALTERED: asStorePointerRelease/asLoadPointerAcquire
 
 BEGIN_AS_NAMESPACE
 
+// ALTERED: a pointer to an object made on one thread and read with the object's contents on another (a value member of a script
+// object, which the garbage collector on another thread walks into): stored after the object is made with a release store, and
+// loaded with an acquire load, so the reader sees the object's contents made. A plain store and load let a weak-memory CPU show
+// the reader the pointer before the contents. On x86/x64 both compile to plain moves. The cast is the one the Apple branch of
+// as_atomic.cpp makes for the counters. Script object members are only aligned to 4 bytes, so a pointer member can be
+// misaligned on 64-bit targets, where the acquire/release instructions need natural alignment (ARM64 raised SIGBUS): such a
+// slot gets a plain access with a fence on the right side instead.
+inline bool asIsPointerAligned(const void *slot)
+{
+	return (reinterpret_cast<asPWORD>(slot) & (sizeof(void*) - 1)) == 0;
+}
+inline void asStorePointerRelease(void **dst, void *value)
+{
+	if( asIsPointerAligned(dst) )
+		reinterpret_cast<std::atomic<void*>*>(dst)->store(value, std::memory_order_release);
+	else
+	{
+		std::atomic_thread_fence(std::memory_order_release);
+		*dst = value;
+	}
+}
+inline void *asLoadPointerAcquire(void *const *src)
+{
+	if( asIsPointerAligned(src) )
+		return reinterpret_cast<const std::atomic<void*>*>(src)->load(std::memory_order_acquire);
+	void *value = *src;
+	std::atomic_thread_fence(std::memory_order_acquire);
+	return value;
+}
+
 class asCAtomic
 {
 public:
