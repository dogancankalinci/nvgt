 // TODO: cleanup: This method should probably be a member of the engine
 asCGlobalProperty *asCScriptFunction::GetPropertyByGlobalVarPtr(void *gvarPtr)
 {
+	// ALTERED: under the engine's function table lock: a function is released on any thread (a compiled function or a
+	// default value's function let go of, a delegate the collector frees), while a build adds global variables to this map
+	// and the deletion of a discarded module removes them, rebalancing the tree and freeing its nodes under the lookup
+	asCGlobalProperty *prop = 0;
+	ENTERCRITICALSECTION(engine->functionTableLock);
 	asSMapNode<void*, asCGlobalProperty*> *node;
 	if( engine->varAddressMap.MoveTo(&node, gvarPtr) )
 	{
 		asASSERT(gvarPtr == node->value->GetAddressOfValue());
-		return node->value;
+		prop = node->value;
 	}
-	return 0;
+	LEAVECRITICALSECTION(engine->functionTableLock);
+	return prop;
 }
 
