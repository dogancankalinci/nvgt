 /* iOS, Android, Marmalade, and Linux with soft-float ABI goes here */
 
+/* ALTERED: these routines carry ARM EHABI unwind information (.fnstart/.save/.setfp/.fnend). Without it the linker
+   covers them with EXIDX_CANTUNWIND, so a C++ exception thrown by a registered function could not unwind through them
+   to the catch in CallSystemFunction and the process ended in std::terminate. Each routine also saves r10 (only to keep
+   the stack 8-byte aligned) and r11, keeps its frame in r11 for the unwinder because the stack it hands to the callee
+   moves by a variable amount, reads its fifth argument 32 bytes up instead of 24, and restores sp from r11. The stack
+   arguments are copied through r12 below the already lowered sp instead of by moving sp up over them, and the ObjLast
+   routines store the object pointer through r11 after lowering sp rather than below sp before it: until then those
+   values sat below sp, where a signal handler running on the thread would overwrite them. */
+
+    .syntax unified
+    .arm
+    .text
+    .align  2
+
 .global armFunc
 .global armFuncR0
 .global armFuncR0R1
@@ -59,9 +73,20 @@
 .type armFuncObjLast, %function
 .type armFuncR0ObjLast, %function
 
+#if defined (__ARM_ARCH_4T__) || defined (__ARM_ARCH_4__)
+/* older ARM didn't support blx */
+#define CALL_R4 mov lr, pc; mov pc, r4
+#else
+#define CALL_R4 blx r4
+#endif
+
 /* --------------------------------------------------------------------------------------------*/
 armFunc:
-    stmdb   sp!, {r4-r8, lr}
+    .fnstart
+    push    {r4-r8, r10, r11, lr}
+    .save   {r4-r8, r10, r11, lr}
+    mov     r11, sp
+    .setfp  r11, sp
     mov     r6, r0  /* arg table */
     movs    r7, r1  /* arg size (also set the condition code flags so that we detect if there are no arguments) */
     mov     r4, r2  /* function address */
@@ -85,26 +110,26 @@ armFunc:
     add     r8, r7, #4        /* ensure 8-byte stack alignment */
     bic     r8, r8, #4
     sub     sp, sp, r8
-    mov     r12, sp           /* copy size != frame size, so store frame start sp */
+    mov     r12, sp
 stackargsloop:
     ldr     r5, [r6], #4
-    str     r5, [sp], #4
+    str     r5, [r12], #4
     subs    r7, r7, #4
     bne     stackargsloop
-    mov     sp, r12
 nomoreargs:
-#if defined (__ARM_ARCH_4T__) || defined (__ARM_ARCH_4__)
-    mov    lr, pc   /* older ARM didn't support blx */
-    mov    pc, r4
-#else
-    blx     r4
-#endif
-    add     sp, sp, r8
-    ldmia   sp!, {r4-r8, pc}
+    CALL_R4
+    mov     sp, r11
+    pop     {r4-r8, r10, r11, pc}
