+	// ALTERED: (and a thread creating it holds a reference of its own, so this one isn't the last.) An object that has weak
+	// references is released under the flag's lock, under which a weak reference turns into a strong one (CScriptWeakRef::Get):
+	// whether this is the last reference, the flag that says the object is gone, and every other release are decided there one
+	// at a time. The reference count was read twice outside the lock, once for the flag
+	// and once for the destructor: another thread that turned a weak reference strong and let go of it in between (or the
+	// last two references let go of on two threads at once) had the object destroyed with the flag never set, and a weak
+	// reference then added a reference to the freed object; or the flag was set on an object that another thread still held.
+	if( extra && extra->weakRefFlag )
+	{
+		extra->weakRefFlag->Lock();
+		if( refCount.get() != 1 )
+		{
+			// Not the last reference: no other release or weak reference can make this one the last meanwhile
+			int r = refCount.atomicDec();
+			extra->weakRefFlag->Unlock();
+			return r;
+		}
+		// The last reference: no weak reference can turn strong after this
+		extra->weakRefFlag->SetLocked(true);
+		extra->weakRefFlag->Unlock();
 	}
 
 	// Call the script destructor behaviour if the reference counter is 1.
@@ -669,6 +681,47 @@
