 }
 
+// ALTERED: the garbage collector found the object with no reference but its own and lets go of it (DestroyNewGarbage,
+// DestroyOldGarbage). It used Release() and, when the object was still alive afterwards, added its reference back: a weak
+// reference turned into a strong one on another thread in between (CScriptWeakRef::Get) kept the object alive past that
+// Release(), and when that thread let go of it before the collector added its reference back, the object was destroyed and
+// the collector's AddRef() wrote to freed memory. Here the weak references are marked dead under their lock only while the
+// collector's reference is still the only one; otherwise, or when the destructor stores a new reference to the object, the
+// collector keeps its reference and the object stays in its list. Returns 0 when the object was destroyed.
+int asCScriptObject::ReleaseByCollector()
+{
+	gcFlag = false;
+
+	if( extra && extra->weakRefFlag )
+	{
+		extra->weakRefFlag->Lock();
+		if( refCount.get() != 1 )
+		{
+			extra->weakRefFlag->Unlock();
+			return refCount.get();
+		}
+		extra->weakRefFlag->SetLocked(true);
+		extra->weakRefFlag->Unlock();
+	}
+	else if( refCount.get() != 1 )
+		return refCount.get();
+
+	if( !isDestructCalled )
+		CallDestructor();
+
+	// Resurrected by the destructor
+	if( refCount.get() != 1 )
+		return refCount.get();
+
+	// Nothing else can add a reference now: the weak references are dead and the collector's is the only one
+	if( refCount.atomicDec() == 0 && !hasRefCountReachedZero )
+	{
+		hasRefCountReachedZero = true;
+		Destruct();
+	}
+	return 0;
+}
