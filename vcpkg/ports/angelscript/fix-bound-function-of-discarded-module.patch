 // internal
+// ALTERED: whether an imported function can be called through the function it is bound to. A binding holds an internal
+// reference, which keeps the function object but doesn't keep its module: when that module is discarded or rebuilt the
+// function loses its bytecode (asCScriptFunction::DestroyInternal) and stays a script function, and the call followed the
+// missing bytecode (a null pointer dereference). It is an unbound function now, as one never bound is, until it is bound again.
+static inline bool IsBoundFunctionCallable(const asCScriptFunction *func)
+{
+	return func != 0 && (func->funcType != asFUNC_SCRIPT || func->scriptData != 0);
+}
