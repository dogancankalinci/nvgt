+// ALTERED: an object that goes in a pass can leave another with only the collector's reference, which is found by the next pass. Going
+// over the list the same way each time, a linked list took a pass for each of its objects when it was made so that the end of the list
+// is what goes first (a full cycle took 12 seconds for 32000 objects and four times that for twice as many). Passes now take turns going
+// each way, so that such a chain goes in one pass, whichever way it was made.
+static bool NextToDestroy(asUINT &idx, bool backward, asUINT length)
+{
+	if( !backward )
+		return ++idx < length;
+	if( idx == 0 )
+		return false;
+	if( idx > length )
+		idx = length;
+	return --idx < length;
+}
