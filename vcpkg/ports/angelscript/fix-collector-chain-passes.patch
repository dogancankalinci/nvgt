+// ALTERED: the swaps that take objects out of the lists leave them in no order, so that a chain went back and forth over the list, and
+// a full cycle needed a pass for every other object of it whichever way the passes went (see NextToDestroy). A full cycle goes through
+// every object anyway, and starts with them in the order they were made.
+int asCGarbageCollector::CompareSeqNbr(const void *a, const void *b)
+{
+	asUINT seqA = ((const asSObjTypePair*)a)->seqNbr, seqB = ((const asSObjTypePair*)b)->seqNbr;
+	return seqA < seqB ? -1 : (seqA > seqB ? 1 : 0);
+}
+
+void asCGarbageCollector::SortOldObjects()
+{
+	// Only the collector changes the old list, but take the lock as for every other use of it
+	ENTERCRITICALSECTION(gcCritical);
+	if( gcOldObjects.GetLength() > 1 )
+		qsort(gcOldObjects.AddressOf(), gcOldObjects.GetLength(), sizeof(asSObjTypePair), CompareSeqNbr);
+	LEAVECRITICALSECTION(gcCritical);
+}
