@@ -974,6 +974,14 @@
 			if( m_initialFunction->objectType )
 				offset += AS_PTR_SIZE;
 
+			// ALTERED: SetProgramPointer pushes the object of a delegate in front of the arguments and moves the stack
+			// frame pointer down over it, so with a delegate prepared the return value's address is one pointer further
+			// up. It was read from the object's slot: a delegate whose method returns an object by value (e.g. a string,
+			// run by a context of its own) handed back its own object as the returned value, and when the context was
+			// unprepared the value type's destructor ran on that object while the returned value leaked.
+			if( m_initialFunction->funcType == asFUNC_DELEGATE )
+				offset += AS_PTR_SIZE;
+
 			return *(void**)(&m_regs.stackFramePointer[offset]);
 		}
 
