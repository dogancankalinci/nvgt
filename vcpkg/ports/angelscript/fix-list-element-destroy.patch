+// ALTERED: the end of the part of the init list buffer held by the variable at stack offset var whose elements have been
+// constructed, for a frame stopped at pos (see CleanStackFrame), for DestroyList. The compiler constructs an element of a value
+// type in the buffer with asBC_PshListElmnt and a call right after it, before the element's value is computed and assigned,
+// and does so in the order of the buffer, with no jump back in between, so the elements constructed are those below the
+// furthest element whose call has returned since the variable's buffer was allocated (the last asBC_AllocMem of the variable
+// before pos: another list may have used the variable before, or in the branch of a condition not taken). A call is still
+// running (it raised the exception, or the frame is in it) when pos is inside it. The assignment of a constructed element
+// that pushes it the same way (a registered opAssign) is at an element already counted.
+static asUINT ListMadeEnd(asCScriptFunction *func, int var, asUINT pos)
+{
+	asDWORD *bc = func->scriptData->byteCode.AddressOf();
+	asUINT length = func->scriptData->byteCode.GetLength();
+	asUINT madeEnd = 0;
+	for( asUINT p = 0; p < length && p < pos; p += asBCTypeSize[asBCInfo[*(asBYTE*)&bc[p]].type] )
+	{
+		asBYTE op = *(asBYTE*)&bc[p];
+		if( op == asBC_AllocMem && asBC_SWORDARG0(&bc[p]) == var )
+			madeEnd = 0;
+		else if( op == asBC_PshListElmnt && asBC_SWORDARG0(&bc[p]) == var )
+		{
+			asUINT next = p + asBCTypeSize[asBCInfo[asBC_PshListElmnt].type];
+			while( next < length && *(asBYTE*)&bc[next] == asBC_JitEntry )
+				next += asBCTypeSize[asBCInfo[asBC_JitEntry].type];
+			if( next >= length )
+				continue;
+			asBYTE call = *(asBYTE*)&bc[next];
+			if( (call == asBC_CALLSYS || call == asBC_CALL || call == asBC_Thiscall1) &&
+				next + asBCTypeSize[asBCInfo[call].type] <= pos &&
+				asBC_DWORDARG(&bc[p]) + 1 > madeEnd )
+				madeEnd = asBC_DWORDARG(&bc[p]) + 1;
+		}
+	}
+	return madeEnd;
+}
