+
+// ALTERED: see m_importHolds
+void asCContext::HoldImportedFunction(asCScriptFunction *func)
+{
+	if( func->module != 0 && func->module == m_currentFunction->module )
+		return;
+
+	SImportHold hold = { func, m_callStack.GetLength() };
+	func->AddRef();
+	m_importHolds.PushLast(hold);
+}
+
+void asCContext::ReleaseImportHolds()
+{
+	while( m_importHolds.GetLength() && m_importHolds[m_importHolds.GetLength() - 1].callStackLength >= m_callStack.GetLength() )
+	{
+		asCScriptFunction *func = m_importHolds[m_importHolds.GetLength() - 1].func;
+		m_importHolds.SetLength(m_importHolds.GetLength() - 1);
+		func->Release();
+	}
 }
 
