+// ALTERED: the imported functions' id bookkeeping, done by asCModule and the loader before (see AddScriptFunction for why it
+// takes functionTableLock and for the robust take of the id)
+int asCScriptEngine::GetNextImportedFunctionId()
+{
+	ENTERCRITICALSECTION(functionTableLock);
+	int id;
+	if( freeImportedFunctionIdxs.GetLength() )
+		id = FUNC_IMPORTED | (asUINT)freeImportedFunctionIdxs[freeImportedFunctionIdxs.GetLength()-1];
+	else
+		id = FUNC_IMPORTED | (asUINT)importedFunctions.GetLength();
+	LEAVECRITICALSECTION(functionTableLock);
+
+	return id;
+}
+
+void asCScriptEngine::AddImportedFunctionInfo(int id, sBindInfo *info)
+{
+	ENTERCRITICALSECTION(functionTableLock);
+
+	asUINT idx = asUINT(id & ~FUNC_IMPORTED);
+	for( asUINT n = freeImportedFunctionIdxs.GetLength(); n-- > 0; )
+	{
+		if( asUINT(freeImportedFunctionIdxs[n]) == idx )
+		{
+			freeImportedFunctionIdxs.RemoveIndex(n);
+			break;
+		}
+	}
+
+	if( idx >= importedFunctions.GetLength() )
+	{
+		GrowSharedTable(importedFunctions, idx + 1);
+		while( importedFunctions.GetLength() < idx )
+		{
+			freeImportedFunctionIdxs.PushLast(int(importedFunctions.GetLength()));
+			importedFunctions.PushLast(0);
+		}
+		importedFunctions.PushLast(info);
+	}
+	else
+	{
+		asASSERT( importedFunctions[idx] == 0 );
+		importedFunctions[idx] = info;
+	}
+
+	LEAVECRITICALSECTION(functionTableLock);
 }
 
