 void asCScriptEngine::AddScriptFunction(asCScriptFunction *func)
 {
+	// ALTERED: under functionTableLock. The id came from GetNextScriptFunctionId, which only looked at the next free id: a
+	// function released on another thread since then can have added a free id after it (the id was then left among the free
+	// ids, and given to another function later, so two functions had the same id: calls by id reached the other one, and the
+	// release of either emptied the slot of the other), or taken the last slot away (the id was then past the end of the
+	// table). The id is now taken out of the free ids wherever it is, and slots left between the end of the table and the id
+	// become free ids. The table grows without freeing the buffer other threads' VMs read, see GrowSharedTable.
+	ENTERCRITICALSECTION(functionTableLock);
