-		freeScriptFunctionIds.PopLast();
+	for( asUINT n = freeScriptFunctionIds.GetLength(); n-- > 0; )
+	{
+		if( freeScriptFunctionIds[n] == func->id )
+		{
+			freeScriptFunctionIds.RemoveIndex(n);
+			break;
+		}
+	}
 
-	if( asUINT(func->id) == scriptFunctions.GetLength() )
+	if( asUINT(func->id) >= scriptFunctions.GetLength() )
+	{
+		GrowSharedTable(scriptFunctions, asUINT(func->id) + 1);
+		while( scriptFunctions.GetLength() < asUINT(func->id) )
+		{
+			freeScriptFunctionIds.PushLast(int(scriptFunctions.GetLength()));
+			scriptFunctions.PushLast(0);
+		}
