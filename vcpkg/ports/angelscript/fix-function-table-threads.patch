+// ALTERED: grows a table that other threads read without a lock (see functionTableLock) so that it holds at least minLength
+// elements without reallocating: the elements are copied into a new buffer, which is published only after the copy is
+// complete, and the previous buffer is kept until the engine is destroyed, as a reader may have taken its address just
+// before. The buffers retired this way add up to less than the table's final size. The caller holds functionTableLock.
+template<class T>
+void asCScriptEngine::GrowSharedTable(asCArray<T> &table, asUINT minLength)
+{
+	if( minLength <= table.GetCapacity() )
+		return;
+
+	asUINT capacity = table.GetCapacity() * 2;
+	if( capacity < minLength )
+		capacity = minLength;
+	if( capacity < 64 )
+		capacity = 64;
+	T *buffer = asNEWARRAY(T, capacity);
+	if( buffer == 0 )
+		return; // Out of memory: the table will try to grow itself as before
+	for( asUINT n = 0; n < table.length; n++ )
+		buffer[n] = table.array[n];
+
+	// The atomic operation is a full memory barrier on every platform: the copied elements are visible to other threads
+	// before the address of the new buffer is
+	tableBarrier.atomicInc();
+
+	T *old = table.array;
+	table.array = buffer;
+	table.maxLength = capacity;
+
+	// A small table uses a buffer inside the array object itself, which is not freed
+	if( old && (reinterpret_cast<char*>(old) < reinterpret_cast<char*>(&table) || reinterpret_cast<char*>(old) >= reinterpret_cast<char*>(&table + 1)) )
+		retiredTables.PushLast(old);
+}
