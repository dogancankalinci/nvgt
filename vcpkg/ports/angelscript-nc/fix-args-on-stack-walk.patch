+// ALTERED: the dwords the function called from a stack level took off its stack: its arguments, return address and object
+// pointer, and the address of the object's variable that asBC_ALLOC (a script class's factory) pushed under the arguments of
+// the constructor it called, which stays on the stack until the constructor returns
+static asUINT ArgsOfCalledFunction(asCScriptFunction *func, asDWORD *progPointer, asCScriptFunction *calledFunc)
+{
+	asUINT space = calledFunc->GetSpaceNeededForArguments() + (calledFunc->DoesReturnOnStack() ? AS_PTR_SIZE : 0) + (calledFunc->GetObjectType() ? AS_PTR_SIZE : 0);
+	const asUINT allocSize = asBCTypeSize[asBCInfo[asBC_ALLOC].type];
+	const asUINT pos = asUINT(progPointer - func->scriptData->byteCode.AddressOf());
+	if( pos >= allocSize && *(asBYTE*)&func->scriptData->byteCode[pos - allocSize] == asBC_ALLOC &&
+		func->GetCalledFunction(pos - allocSize) == calledFunc )
+		space += AS_PTR_SIZE;
+	return space;
+}
