+// ALTERED: CallSystemFunction and CallGeneric returned without touching the arguments when the object pointer of a method
+// was null, but the arguments the caller pushed belong to the called function: the reference held by a handle argument and
+// the copy of an object passed by value were never released or freed, as neither the compiled script nor the exception
+// handler cleans up the arguments of a system function call. They are released and freed here and their stack slots
+// cleared, so the arguments are consumed whether the function is called or not.
+void CleanArgsOfUnmadeCall(asCContext *context, asCScriptFunction *descr, asDWORD *args)
+{
+	// The arguments of a variadic function follow a count of them, which this doesn't walk
+	if( descr->IsVariadic() )
+		return;
+
+	asCScriptEngine *engine = context->m_engine;
+	int offset = 0;
+	if( descr->DoesReturnOnStack() )
+		offset += AS_PTR_SIZE;
+	for( asUINT n = 0; n < descr->parameterTypes.GetLength(); n++ )
+	{
+		asCDataType &dt = descr->parameterTypes[n];
+		if( (dt.IsObject() || dt.IsFuncdef()) && !dt.IsReference() )
+		{
+			void **addr = (void**)&args[offset];
+			if( *addr )
+			{
+				if( dt.GetTypeInfo()->flags & asOBJ_FUNCDEF )
+					reinterpret_cast<asCScriptFunction*>(*addr)->Release();
+				else if( dt.GetTypeInfo()->flags & asOBJ_REF )
+				{
+					asSTypeBehaviour *beh = &CastToObjectType(dt.GetTypeInfo())->beh;
+					asASSERT( (dt.GetTypeInfo()->flags & asOBJ_NOCOUNT) || beh->release );
+					if( beh->release )
+						engine->CallObjectMethod(*addr, beh->release);
+				}
+				else
+				{
+					asSTypeBehaviour *beh = &CastToObjectType(dt.GetTypeInfo())->beh;
+					if( beh->destruct )
+						engine->CallObjectMethod(*addr, beh->destruct);
+					engine->CallFree(*addr);
+				}
+				*addr = 0;
+			}
+		}
+		offset += dt.GetSizeOnStackDWords();
+	}
+}
