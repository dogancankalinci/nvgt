+// ALTERED: the position of the first instruction at or after pos that isn't an asBC_JitEntry. Without the bytecode optimizer
+// (asEP_OPTIMIZE_BYTECODE off, which NVGT's scripting.do_not_optimize_bytecode sets) or with asEP_INCLUDE_JIT_INSTRUCTIONS, a
+// JitEntry follows every call, and the info the compiler records for the call's object (asOBJ_INIT after a constructor or a
+// function returning the object, asOBJ_UNINIT after a destructor) comes after it. A frame that stopped right after a registered
+// function (an abort or a suspend acted on after its call) has its program pointer on the JitEntry, before that info, so the
+// object a destructor had just destroyed counted as alive and was destroyed a second time, and one just made counted as not
+// made and leaked. A JitEntry does nothing: a frame stopped on it is stopped after it.
+static asUINT SkipJitEntries(asCScriptFunction *func, asUINT pos)
+{
+	asDWORD *bc = func->scriptData->byteCode.AddressOf();
+	asUINT length = func->scriptData->byteCode.GetLength();
+	while( pos < length && *(asBYTE*)&bc[pos] == asBC_JitEntry )
+		pos += asBCTypeSize[asBCInfo[asBC_JitEntry].type];
+	return pos;
+}
