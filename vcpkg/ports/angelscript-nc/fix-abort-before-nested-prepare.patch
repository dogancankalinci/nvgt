diff --git a/sdk/angelscript/source/as_context.cpp b/sdk/angelscript/source/as_context.cpp
index a33bda8..03b9d2a 100644
--- a/sdk/angelscript/source/as_context.cpp
+++ b/sdk/angelscript/source/as_context.cpp
@@ -228,6 +228,7 @@ asCContext::asCContext(asCScriptEngine *engine, bool holdRef)
 	m_argsOnStackCacheProgPos   = 0;
 	m_argumentsSize             = 0;
 	m_doAbort                   = false;
+	m_requestsAfterPushState    = false; // ALTERED: see Prepare
 	m_exceptionCallbackObj      = 0;
 	m_exceptionLine             = 0;
 	m_exceptionColumn           = 0;
@@ -848,11 +849,22 @@ int asCContext::Prepare(asIScriptFunction *func)
 	// that had been meant for the one before. In a context of its own the request is dropped, as the execution it was for
 	// is over; in a nested call it is meant for the interrupted execution, which gets it with the requests PushState put
 	// aside, so that preparing the next nested call (such as the next comparison of a sort) doesn't lose it.
-	if( m_status == asEXECUTION_FINISHED && m_doAbort && m_nestedRequests.GetLength() )
-		m_nestedRequests[m_nestedRequests.GetLength() - 1] |= 3;
-	m_doAbort                 = false;
-	m_doSuspend               = false;
+	// ALTERED: also for the first Prepare of a nested call, and each request taken and cleared in one step, the suspend half first, as
+	// PushState takes them (Abort() on another thread sets the abort half first). An Abort() or Suspend() from another thread that came
+	// after PushState had taken the interrupted execution's requests and before the nested call was prepared was cleared here, as the
+	// status PushState leaves is asEXECUTION_UNINITIALIZED: the interrupted execution never stopped (the script went on after exit()
+	// was called on another thread), and an Abort() split by this Prepare (its abort half cleared, its suspend half set after it) made
+	// the interrupted execution suspend instead, and its Execute returned asEXECUTION_SUSPENDED for an abort. A request made after the
+	// clear is the nested execution's, which acts on it at its first suspend point (the sign to look for one is set again for it, see
+	// ClearLineCallback). A context unprepared since still drops what was pending, as before (an application dropping a late abort
+	// of its own that way, such as NVGT's script_function.call(), relies on that).
+	bool suspendRequest = m_doSuspend.exchange(false);
+	bool abortRequest = m_doAbort.exchange(false);
+	if( (abortRequest || suspendRequest) && m_nestedRequests.GetLength() && (m_requestsAfterPushState || m_status == asEXECUTION_FINISHED) )
+		m_nestedRequests[m_nestedRequests.GetLength() - 1] |= asBYTE(abortRequest ? 3 : 2);
+	m_requestsAfterPushState = false;
 	DoProcessSuspend()   = m_lineCallback;
+	if( m_doSuspend ) DoProcessSuspend() = true;
 	m_externalSuspendRequest  = false;
 	m_status = asEXECUTION_PREPARED;
 	m_regs.programPointer = 0;
@@ -904,6 +916,9 @@ int asCContext::Unprepare()
 	// ALTERED: a Prepare that failed set up no stack frame and stored no object pointer, see Prepare
 	bool hasStackFrame = !(m_isStackMemoryNotAllocated && m_regs.programPointer == 0);
 
+	// ALTERED: see Prepare
+	m_requestsAfterPushState = false;
+
 	// Only clean the stack if the context was prepared but not executed until the end
 	if( m_status != asEXECUTION_UNINITIALIZED &&
 		m_status != asEXECUTION_FINISHED )
@@ -1927,6 +1942,7 @@ int asCContext::PushState()
 	bool suspendRequest = m_doSuspend.exchange(false);
 	bool abortRequest = m_doAbort.exchange(false);
 	m_nestedRequests.PushLast(asBYTE(abortRequest ? 3 : suspendRequest ? 2 : 0));
+	m_requestsAfterPushState = true; // ALTERED: see Prepare
 
 	// Push the system function too, which will serve both as a marker and
 	// informing which system function that created the nested call
diff --git a/sdk/angelscript/source/as_context.h b/sdk/angelscript/source/as_context.h
