+// ALTERED: asBC_ALLOC had no memory for the object. The arguments pushed for its constructor belong to the call that isn't made
+// (neither the compiled script nor the exception handler cleans the arguments of an asBC_ALLOC), so they are released and
+// popped here with the address of the variable the object was for, which is left null; the script gets an "Out of memory"
+// exception at the instruction.
+void asCContext::AllocFailed(asCScriptFunction *constructor, asDWORD *bc, asDWORD *sp, asDWORD *fp)
+{
+	int argSize = constructor ? CleanArgsOfUnmadeCall(this, constructor, sp) : 0;
+	asDWORD **a = (asDWORD**)*(asPWORD*)(sp + argSize);
+	if( a )
+		*a = 0;
+
+	m_regs.programPointer    = bc;
+	m_regs.stackPointer      = sp + argSize + AS_PTR_SIZE;
+	m_regs.stackFramePointer = fp;
+	SetInternalException("Out of memory");
+}
