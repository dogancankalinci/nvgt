+// ALTERED: how many of count entries still to read to make room for at once: up to 65536 at first, then up to as many as
+// there already are (so the room doubles), so that a corrupt count or length isn't allocated up front (see ReadCount)
+static asUINT PreallocCount(asUINT count, asUINT have = 0)
+{
+	asUINT most = have > 65536 ? have : 65536;
+	return count < most ? count : most;
+}
+
+// ALTERED: makes room for entry n of count in arr, which holds entries up to n (see PreallocCount)
+template <class T>
+static bool ReadRoom(asCArray<T> &arr, asUINT n, asUINT count)
+{
+	if( n < arr.GetLength() )
+		return true;
+	asUINT size = n + PreallocCount(count - n, n);
+	arr.SetLength(size);
+	return arr.GetLength() == size;
+}
