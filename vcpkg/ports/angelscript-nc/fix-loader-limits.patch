+// ALTERED: a count of entries. The build sets no limit to these, and the 1000000 each count was limited to refused bytecode
+// a build wrote (more than a million of anything, such as the instructions of a long function or a big initialisation list).
+// A count is taken up to what an int holds; the arrays are not sized from it up front (PreallocCount, ReadRoom), so a corrupt
+// count fails at the end of the stream, where the reads run out, instead of allocating it first.
+asUINT asCReader::ReadCount()
+{
+	asUINT count = ReadEncodedUInt();
+	if( count > 0x7FFFFFFF )
+	{
+		Error(TXT_INVALID_BYTECODE_d);
+		return 0;
+	}
+	return count;
+}
+
+// ALTERED: a program position, in number of instructions, of a function of numInstructions instructions. The writer saves
+// positions inside the function (one past its end is saved as its last instruction), and TranslateFunction looks them up in a
+// table of that many entries.
+asUINT asCReader::ReadPosition(asUINT numInstructions)
+{
+	asUINT pos = ReadEncodedUInt();
+	if( pos >= numInstructions )
+	{
+		Error(TXT_INVALID_BYTECODE_d);
+		return 0;
+	}
+	return pos;
+}
