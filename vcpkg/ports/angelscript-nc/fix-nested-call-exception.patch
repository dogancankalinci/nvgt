+// ALTERED: ends a nested call that the engine made on this context to run a script function for the application (a script
+// class's factory, copy factory, opAssign or method run through CallScriptObjectMethod) and that didn't finish: pops its
+// state and forwards an exception or an abort to the execution it returned to. A forwarded exception keeps the nested
+// call's own text and the function, line and section it was raised at; the engine raised "An exception occurred in a
+// nested call" in its place, so the exception of a script constructor run that way (the elements of array<C> a(5), a
+// dictionary's or any's copy of a value) lost its message and line. PopState clears the exception, so it is taken first.
+void asCContext::PopNestedCall(int r)
+{
+	asCString text;
+	int location[4] = {0, 0, 0, 0};
+	if( r == asEXECUTION_EXCEPTION )
+	{
+		text        = m_exceptionString;
+		location[0] = m_exceptionFunction;
+		location[1] = m_exceptionLine;
+		location[2] = m_exceptionColumn;
+		location[3] = m_exceptionSectionIdx;
+	}
+
+	PopState();
+
+	// As SetException: only while a registered function is being called
+	if( r == asEXECUTION_EXCEPTION && m_callingSystemFunction )
+		SetInternalException(text.AddressOf(), true, false, location);
+	else if( r == asEXECUTION_ABORTED )
+		Abort();
+}
