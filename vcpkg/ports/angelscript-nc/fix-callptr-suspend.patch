@@ -4590,6 +4602,7 @@
 				else if (func->funcType == asFUNC_SYSTEM)
 				{
 					m_regs.stackPointer += CallSystemFunction(func->id, this);
+					calledSystemFunction = true;
 
 					// Update program position after the call so the line number
 					// is correct in case the system function queries it
@@ -4604,6 +4617,7 @@
 						// allows it, and asBC_CALLBND calls it as one), which was run here as a script function, a null
 						// pointer dereference on its missing bytecode. It is called as asBC_CALLBND calls it.
 						m_regs.stackPointer += CallSystemFunction(funcId, this);
+						calledSystemFunction = true;
 
 						// Update program position after the call so the line number
