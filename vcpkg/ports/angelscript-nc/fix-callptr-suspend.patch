@@ -4639,6 +4653,18 @@
 			// If status isn't active anymore then we must stop
 			if( m_status != asEXECUTION_ACTIVE )
 				return;
+
+			// ALTERED: a suspend requested by the registered function (such as a context manager's sleep() or yield(), called through
+			// a function handle or a delegate) is acted on before the next instruction, as asBC_CALLSYS and asBC_Thiscall1 do. It was
+			// left for the next suspend point, so the script went on past the call first, running and finishing the code after it
+			// when built without line cues (the suspend points are then only at loops and function entries). A yield() that the
+			// execution ended without acting on still moved the context manager on to the next co-routine, and the manager removed
+			// that co-routine instead of the one that ended, then executed the null left in its place.
+			if( calledSystemFunction && m_regs.doProcessSuspend && m_doSuspend )
+			{
+				m_status = asEXECUTION_SUSPENDED;
+				return;
+			}
 		}
