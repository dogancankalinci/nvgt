+// ALTERED: The script stack holds every 8 and 16 bit argument zero-extended to 32 bits, signed or not, but the native
+// calling conventions of clang on x86-64, Apple's arm64 ABI and 32-bit ARM (AAPCS) have the caller extend such an argument
+// to 32 bits according to its type, and the code clang generates relies on it: a function taking an int8 read -1 as 255.
+// The CallSystemFunctionNative implementations pass every 32-bit primitive argument through this.
+asDWORD ExtendSubwordArg(const asCDataType &type, asDWORD value)
+{
+#ifdef AS_BIG_ENDIAN
+	// The value is not in the low bits of the DWORD
+	return value;
+#else
+	if( type.IsReference() || type.IsObjectHandle() )
+		return value;
+
+	eTokenType tokenType = type.GetTokenType();
+	if( type.IsEnumType() )
+		tokenType = CastToEnumType(type.GetTypeInfo())->enumType.GetTokenType();
+
+	switch( tokenType )
+	{
+	case ttInt8:   return asDWORD(int(asINT8(value)));
+	case ttInt16:  return asDWORD(int(asINT16(value)));
+	case ttUInt8:  return value & 0xFF;
+	case ttUInt16: return value & 0xFFFF;
+#if AS_SIZEOF_BOOL == 1
+	case ttBool:   return value & 0xFF;
+#endif
+	default:       return value;
+	}
+#endif
+}
