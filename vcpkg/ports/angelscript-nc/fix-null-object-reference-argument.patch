+// ALTERED: a reference to an object handed to a registered function is the address of the object, which is null when the
+// object doesn't exist yet: a member of a value type stored on the heap (a string, a dictionaryValue, a ref) of a script
+// object whose constructor hasn't made it, read by a method a base class's constructor calls (NVGT initializes members after
+// the base class's constructor, asEP_MEMBER_INIT_MODE 0) or by a copy of the object made from one of its member initializers.
+// The script code reading the member pushes the null pointer without a check (asBC_RDSPtr checks the address of the member,
+// not what it holds), and only the object pointer of a method was checked: the function was called with a null reference and
+// crashed (std::string::size on null for `"text" + name`). The call now raises a null pointer exception, as a null object
+// pointer does. The offsets are found once, when the function is prepared.
+static void PrepareObjectRefArgs(asCScriptFunction *func, asSSystemFunctionInterface *internal)
+{
+	internal->objectRefArgs.SetLength(0);
+	// The arguments of a variadic function follow a count of them, see CleanArgsOfUnmadeCall
+	if( func->IsVariadic() )
+		return;
+	int offset = 0;
+	if( func->DoesReturnOnStack() )
+		offset += AS_PTR_SIZE;
+	for( asUINT n = 0; n < func->parameterTypes.GetLength(); n++ )
+	{
+		asCDataType &dt = func->parameterTypes[n];
+		if( dt.IsReference() && dt.IsObject() && !dt.IsObjectHandle() && dt.GetTokenType() != ttQuestion )
+			internal->objectRefArgs.PushLast(short(offset));
+		offset += dt.GetSizeOnStackDWords();
+	}
+}
+
+bool HasNullObjectRefArg(asSSystemFunctionInterface *sysFunc, asDWORD *args)
+{
+	for( asUINT n = 0; n < sysFunc->objectRefArgs.GetLength(); n++ )
+		if( *(asPWORD*)&args[sysFunc->objectRefArgs[n]] == 0 )
+			return true;
+	return false;
+}
