+// ALTERED: the call stack array's length for a number of call states, saturated at the last whole state an asUINT length holds.
+// asEP_MAX_CALL_STACK_SIZE and asEP_INIT_CALL_STACK_SIZE were multiplied by CALLSTACK_FRAME_SIZE in 32 bits, so 477218589 (2^32 / 9)
+// or more wrapped around: a limit of 477218589 calls became 5 array entries (every recursion stopped with a stack overflow 10 calls
+// deep, where the first growth was refused), and the initial size became small and unrelated.
+static asUINT CallStackLength(asUINT states)
+{
+	const asUINT maxStates = 0xFFFFFFFFu / CALLSTACK_FRAME_SIZE;
+	return (states > maxStates ? maxStates : states) * CALLSTACK_FRAME_SIZE;
+}
