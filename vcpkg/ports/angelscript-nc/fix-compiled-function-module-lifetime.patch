+// internal
+// ALTERED: see CompileFunction
+void asCModule::ReleaseUnusedCompiledFunctions()
+{
+	// Let go of outside the lock, which freeing a function can take
+	asCArray<asCScriptFunction *> unused;
+	ACQUIREEXCLUSIVE(m_engine->engineRWLock);
+	for( asUINT n = m_compiledFunctions.GetLength(); n-- > 0; )
+	{
+		asCScriptFunction *func = m_compiledFunctions[n];
+		if( func->externalRefCount.get() == 0 )
+		{
+			m_compiledFunctions.RemoveIndexUnordered(n);
+			unused.PushLast(func);
+		}
+	}
+	RELEASEEXCLUSIVE(m_engine->engineRWLock);
+	for( asUINT n = 0; n < unused.GetLength(); n++ )
+		unused[n]->ReleaseInternal();
+}
