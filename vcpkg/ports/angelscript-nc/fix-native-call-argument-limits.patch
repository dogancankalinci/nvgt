+// ALTERED: whether CallSystemFunctionNative can pass the function's arguments in paramBuffer, which holds
+// ARM_MAX_ARG_DWORDS of them. Nothing limited how many a function had, so a registered function with more (65 int
+// parameters, or on Android and Linux 17 pairs of an int and an int64, as each int64 is aligned to an even dword) was
+// called with the arguments written past paramBuffer, over the rest of the frame. The dwords are counted as
+// CallSystemFunctionNative puts them in the buffer (see there; the two must be kept alike), and PrepareSystemFunction
+// refuses a function that doesn't fit.
+bool CallSystemFunctionNativeArgsFit(asCScriptFunction *descr, asSSystemFunctionInterface *sysFunc)
+{
+	int callConv = sysFunc->callConv;
+	if( sysFunc->hostReturnInMemory )
+		callConv++;
+	bool isThisCallMethod = callConv >= ICC_THISCALL_OBJLAST;
+
+#if !defined(AS_ANDROID) && !defined(AS_LINUX)
+	// Otherwise the arguments are passed from the context's stack, without a copy
+	if( !(sysFunc->takesObjByVal || isThisCallMethod) )
+		return true;
+#endif
+
+#if defined(AS_ANDROID) || defined(AS_LINUX)
+	// The same mask as CallSystemFunctionNative's, which tells the dwords that a 64-bit value can't start at
+	int mask = 1;
+	if( isThisCallMethod )
+		mask = 0;
+	else
+	{
+		switch( callConv )
+		{
+			case ICC_THISCALL:
+			case ICC_CDECL_OBJFIRST:
+			case ICC_VIRTUAL_THISCALL:
+			case ICC_THISCALL_RETURNINMEM:
+			case ICC_CDECL_OBJFIRST_RETURNINMEM:
+			case ICC_VIRTUAL_THISCALL_RETURNINMEM:
+				mask = 0;
+				break;
+			default:
+				break;
+		}
+	}
+	if( sysFunc->hostReturnInMemory )
+		mask = !mask;
+#endif
+
+	int dpos = 2;
+	if( isThisCallMethod && (callConv >= ICC_THISCALL_OBJFIRST &&
+		callConv <= ICC_VIRTUAL_THISCALL_OBJFIRST_RETURNINMEM) )
+		dpos++;
+	for( asUINT n = 0; n < descr->parameterTypes.GetLength(); n++ )
+	{
+		const asCDataType &dt = descr->parameterTypes[n];
+		if( dt.IsObject() && !dt.IsObjectHandle() && !dt.IsReference() )
+		{
+#ifdef COMPLEX_OBJS_PASSED_BY_REF
+			if( dt.GetTypeInfo()->flags & COMPLEX_MASK )
+			{
+				dpos++;
+				continue;
+			}
+#endif
+#if defined(AS_ANDROID) || defined(AS_LINUX)
+			if( ((dt.GetTypeInfo()->flags & asOBJ_APP_CLASS_ALIGN8) ||
+				 ((dt.GetTypeInfo()->flags & (asOBJ_APP_FLOAT | asOBJ_APP_PRIMITIVE)) && dt.GetSizeInMemoryBytes() == 8)) &&
+				((dpos & 1) == mask) )
+				dpos++;
+#endif
+			dpos += dt.GetSizeInMemoryDWords();
+		}
+		else
+		{
+#if defined(AS_ANDROID) || defined(AS_LINUX)
+			if( !dt.IsObjectHandle() && !dt.IsReference() && dt.GetSizeOnStackDWords() == 2 && ((dpos & 1) == mask) )
+				dpos++;
+#endif
+			dpos += dt.GetSizeOnStackDWords();
+		}
+	}
+	if( isThisCallMethod && (callConv >= ICC_THISCALL_OBJLAST &&
+		callConv <= ICC_VIRTUAL_THISCALL_OBJLAST_RETURNINMEM) )
+		dpos++;
+
+	return dpos - 2 <= ARM_MAX_ARG_DWORDS;
+}
