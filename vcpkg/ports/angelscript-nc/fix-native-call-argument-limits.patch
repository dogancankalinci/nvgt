diff --git a/sdk/angelscript/source/as_callfunc_arm64.cpp b/sdk/angelscript/source/as_callfunc_arm64.cpp
index b42cfa0..0bef0bc 100644
--- a/sdk/angelscript/source/as_callfunc_arm64.cpp
+++ b/sdk/angelscript/source/as_callfunc_arm64.cpp
@@ -139,6 +139,163 @@ static inline void PadAppleStack(asQWORD* const argsArray, asQWORD& numArgs, asQ
 }
 #endif
 
+// ALTERED: the number of quadwords stackArgs holds, see CallSystemFunctionNativeArgsFit
+#define ARM64_MAX_STACK_ARG_QWORDS 64
+
+// ALTERED: counts the bytes of stackArgs CallSystemFunctionNative uses for an argument of size bytes that goes on the
+// stack, aligned as it aligns it there
+static inline void ARM64_PlaceStackArg(asQWORD &stackBytes, asUINT align, asUINT size)
+{
+#if defined(AS_IPHONE) || defined(AS_MAC)
+	// Apple aligns an argument on the stack by its size, see PadAppleStack
+	stackBytes = (stackBytes + align - 1) / align * align;
+	stackBytes += size;
+#else
+	// Every argument starts a new quadword
+	UNUSED_VAR(align);
+	stackBytes += (size + sizeof(asQWORD) - 1) / sizeof(asQWORD) * sizeof(asQWORD);
+#endif
+}
+
+// ALTERED: whether CallSystemFunctionNative can pass the function's arguments: stackArgs holds ARM64_MAX_STACK_ARG_QWORDS
+// quadwords for the arguments that don't get a register. Nothing limited how many a function had, so a registered function
+// with more on the stack (73 int64 parameters, or 37 ?&in ones) was called with the arguments written past
+// stackArgs, over the rest of the frame. The arguments are placed as CallSystemFunctionNative places them (see there; the
+// two must be kept alike), and PrepareSystemFunction refuses a function that doesn't fit.
+bool CallSystemFunctionNativeArgsFit(asCScriptFunction *descr, asSSystemFunctionInterface *sysFunc)
+{
+	const int callConv = sysFunc->callConv;
+	asQWORD numGPRegArgs    = 0;
+	asQWORD numFloatRegArgs = 0;
+	asQWORD stackBytes      = 0;
+#if defined(AS_IPHONE) || defined(AS_MAC)
+	const asUINT floatStackSize = sizeof(float);
+	const asUINT typeIdStackSize = sizeof(int);
+#else
+	const asUINT floatStackSize = sizeof(asQWORD);
+	const asUINT typeIdStackSize = sizeof(asQWORD);
+#endif
+
+	if( (callConv >= ICC_THISCALL && callConv <= ICC_VIRTUAL_THISCALL_RETURNINMEM) ||
+		(callConv >= ICC_THISCALL_OBJLAST && callConv <= ICC_VIRTUAL_THISCALL_OBJFIRST_RETURNINMEM) )
+		numGPRegArgs++;
+	if( callConv == ICC_CDECL_OBJFIRST || callConv == ICC_CDECL_OBJFIRST_RETURNINMEM ||
+		callConv == ICC_THISCALL_OBJFIRST || callConv == ICC_THISCALL_OBJFIRST_RETURNINMEM ||
+		callConv == ICC_VIRTUAL_THISCALL_OBJFIRST || callConv == ICC_VIRTUAL_THISCALL_OBJFIRST_RETURNINMEM )
+		numGPRegArgs++;
+
+	for( asUINT n = 0; n < descr->parameterTypes.GetLength(); n++ )
+	{
+		const asCDataType &parmType = descr->parameterTypes[n];
+		const asCTypeInfo *const parmTypeInfo = parmType.GetTypeInfo();
+		if( parmType.IsObject() && !parmType.IsObjectHandle() && !parmType.IsReference() )
+		{
+			const asUINT parmDWords = parmType.GetSizeInMemoryDWords();
+			const asUINT parmQWords = (parmDWords >> 1) + (parmDWords & 1);
+			const asUINT parmBytes = parmType.GetSizeInMemoryBytes();
+			if( (parmTypeInfo->flags & asOBJ_APP_FLOAT) && (parmBytes == sizeof(float) || parmBytes == sizeof(double)) )
+			{
+				if( numFloatRegArgs < FLOAT_ARG_REGISTERS )
+					numFloatRegArgs++;
+				else
+					ARM64_PlaceStackArg(stackBytes, parmBytes, parmBytes);
+				continue;
+			}
+			const bool isHFA = IsRegisterHFA(parmType);
+			if( (parmTypeInfo->flags & COMPLEX_MASK) || (parmQWords > 2 && !isHFA) )
+			{
+				if( numGPRegArgs < GP_ARG_REGISTERS )
+					numGPRegArgs++;
+				else
+					ARM64_PlaceStackArg(stackBytes, sizeof(asQWORD), sizeof(asQWORD));
+				continue;
+			}
+			if( isHFA )
+			{
+				const bool doubles = (parmTypeInfo->flags & asOBJ_APP_CLASS_ALIGN8) != 0;
+				const asUINT memberSize = doubles ? sizeof(double) : sizeof(float);
+				const asUINT members = parmBytes / memberSize;
+				if( numFloatRegArgs + members <= FLOAT_ARG_REGISTERS )
+					numFloatRegArgs += members;
+				else
+				{
+					numFloatRegArgs = FLOAT_ARG_REGISTERS;
+#if defined(AS_IPHONE) || defined(AS_MAC)
+					ARM64_PlaceStackArg(stackBytes, memberSize, parmBytes);
+#else
+					ARM64_PlaceStackArg(stackBytes, sizeof(asQWORD), parmQWords * sizeof(asQWORD));
+#endif
+				}
+			}
+			else
+			{
+				if( numGPRegArgs + parmQWords <= GP_ARG_REGISTERS )
+					numGPRegArgs += parmQWords;
+				else
+				{
+					numGPRegArgs = GP_ARG_REGISTERS;
+					ARM64_PlaceStackArg(stackBytes, sizeof(asQWORD), parmQWords * sizeof(asQWORD));
+				}
+			}
+		}
+		else if( parmType.IsFloatType() && !parmType.IsReference() )
+		{
+			if( numFloatRegArgs >= FLOAT_ARG_REGISTERS )
+				ARM64_PlaceStackArg(stackBytes, floatStackSize, floatStackSize);
+			else
+				numFloatRegArgs++;
+		}
+		else if( parmType.IsDoubleType() && !parmType.IsReference() )
+		{
+			if( numFloatRegArgs >= FLOAT_ARG_REGISTERS )
+				ARM64_PlaceStackArg(stackBytes, sizeof(asQWORD), sizeof(asQWORD));
+			else
+				numFloatRegArgs++;
+		}
+		else if( parmType.GetTokenType() == ttQuestion )
+		{
+			// The reference and then the type id
+			if( numGPRegArgs + 1 <= GP_ARG_REGISTERS )
+				numGPRegArgs++;
+			else
+				ARM64_PlaceStackArg(stackBytes, sizeof(asQWORD), sizeof(asQWORD));
+			if( numGPRegArgs + 1 <= GP_ARG_REGISTERS )
+				numGPRegArgs++;
+			else
+				ARM64_PlaceStackArg(stackBytes, typeIdStackSize, typeIdStackSize);
+		}
+		else
+		{
+			const asUINT parmDWords = parmType.GetSizeOnStackDWords();
+			const asUINT parmQWords = (parmDWords >> 1) + (parmDWords & 1);
+			if( numGPRegArgs + parmQWords <= GP_ARG_REGISTERS )
+				numGPRegArgs += parmQWords;
+			else
+			{
+#if defined(AS_IPHONE) || defined(AS_MAC)
+				asUINT parmBytes = (parmType.IsReference() || parmType.IsObjectHandle()) ? AS_PTR_SIZE * 4 : parmType.GetSizeInMemoryBytes();
+				ARM64_PlaceStackArg(stackBytes, parmBytes, parmBytes);
+#else
+				ARM64_PlaceStackArg(stackBytes, sizeof(asQWORD), parmQWords * sizeof(asQWORD));
+#endif
+			}
+		}
+	}
+#if defined(AS_IPHONE) || defined(AS_MAC)
+	ARM64_PlaceStackArg(stackBytes, sizeof(asQWORD), 0);
+#endif
+
+	if( callConv == ICC_CDECL_OBJLAST || callConv == ICC_CDECL_OBJLAST_RETURNINMEM ||
+		callConv == ICC_THISCALL_OBJLAST || callConv == ICC_THISCALL_OBJLAST_RETURNINMEM ||
+		callConv == ICC_VIRTUAL_THISCALL_OBJLAST || callConv == ICC_VIRTUAL_THISCALL_OBJLAST_RETURNINMEM )
+	{
+		if( numGPRegArgs >= GP_ARG_REGISTERS )
+			ARM64_PlaceStackArg(stackBytes, sizeof(asQWORD), sizeof(asQWORD));
+	}
+
+	return stackBytes <= ARM64_MAX_STACK_ARG_QWORDS * sizeof(asQWORD);
+}
