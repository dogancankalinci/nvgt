-	asEContextState m_status;
-	bool            m_doSuspend;
-	bool            m_doAbort;
-	bool            m_externalSuspendRequest;
+	// ALTERED: atomic. Abort() and Suspend() are made to be called on another thread than the one executing (an application
+	// stopping a script that runs too long, a script thread ending the program), and these were plain variables both threads
+	// read and wrote: a data race, and Abort() read the status and wrote it as two steps, see Abort().
+	std::atomic<asEContextState> m_status;
+	std::atomic<bool> m_doSuspend;
+	std::atomic<bool> m_doAbort;
+	std::atomic<bool> m_externalSuspendRequest;
+	// ALTERED: m_regs.doProcessSuspend is a plain bool of the public asSVMRegisters, which Abort() and Suspend() set on another
+	// thread as well: every access goes through this, as asStorePointerRelease does for pointers.
+	std::atomic<bool> &DoProcessSuspend() { return *reinterpret_cast<std::atomic<bool>*>(&m_regs.doProcessSuspend); }
+	// ALTERED: the read the executing thread makes at every suspend point and after every call of a registered function. Relaxed: it is only
+	// the sign to look at m_doSuspend and m_doAbort, which are read in full order then, and a sign seen one instruction late is acted on at
+	// the next one; a fully ordered read put a memory barrier on each (a dmb on 32-bit ARM, and the suspend point is in every loop).
+	bool ProcessSuspend() const { return reinterpret_cast<const std::atomic<bool>*>(&m_regs.doProcessSuspend)->load(std::memory_order_relaxed); }
 
 	asCScriptFunction *m_currentFunction;
 	asCScriptFunction *m_callingSystemFunction;
