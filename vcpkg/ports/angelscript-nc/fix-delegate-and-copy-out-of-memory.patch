 	asCTypeInfo *GetTypeInfoOfLocalVar(short varOffset);
 
-	void      MakeDelegate(asCScriptFunction *func, void *obj);
+	bool      MakeDelegate(asCScriptFunction *func, void *obj); // ALTERED: false when the delegate couldn't be made, see there
 
 	int       RegisterListPattern(const char *decl, asCScriptNode *listPattern);
 	int       ParseListPattern(asSListPatternNode *&target, const char *decl, asCScriptNode *listPattern);
diff --git a/sdk/angelscript/source/as_scriptobject.cpp b/sdk/angelscript/source/as_scriptobject.cpp
index 8e3271d..21fd0af 100644
--- a/sdk/angelscript/source/as_scriptobject.cpp
+++ b/sdk/angelscript/source/as_scriptobject.cpp
@@ -1183,7 +1183,16 @@ int asCScriptObject::CopyFromAs(const asCScriptObject *other, asCObjectType *in_
 				// Request a context from the engine
 				ctx = engine->RequestContext();
 				if( ctx == 0 )
+				{
+					// ALTERED: the failure is raised on the executing context, as below for a failed Prepare(): the default
+					// opAssign that copies the members of a class here ignores the result, so with no memory for a context the
+					// script's assignment stopped at this member without an exception and the script went on with a half
+					// copied object
+					asIScriptContext *active = asGetActiveContext();
+					if( active )
+						active->SetException("Out of memory");
 					return asERROR;
+				}
 			}
 
 			r = ctx->Prepare(engine->scriptFunctions[in_objType->beh.copy]);
@@ -1193,6 +1202,10 @@ int asCScriptObject::CopyFromAs(const asCScriptObject *other, asCObjectType *in_
 					ctx->PopState();
 				else
 					engine->ReturnContext(ctx);
+				// ALTERED: see above (Prepare() fails when there is no memory for the call)
+				asIScriptContext *active = asGetActiveContext();
+				if( active )
+					active->SetException("Out of memory");
 				return r;
 			}
 
