diff --git a/sdk/angelscript/source/as_scriptfunction.cpp b/sdk/angelscript/source/as_scriptfunction.cpp
index 6c31938..80f17d7 100644
--- a/sdk/angelscript/source/as_scriptfunction.cpp
+++ b/sdk/angelscript/source/as_scriptfunction.cpp
@@ -180,9 +180,14 @@ asCScriptFunction *CreateDelegate(asCScriptFunction *func, void *obj)
 	// Create an instance of a asCScriptFunction with the type asFUNC_DELEGATE
 	// The delegate shouldn't have a function id and is not added to the engine->scriptFunctions
 	asCScriptFunction *delegate = asNEW(asCScriptFunction)(static_cast<asCScriptEngine*>(func->GetEngine()), 0, asFUNC_DELEGATE);
-	if( delegate )
-		delegate->MakeDelegate(func, obj);
-	else
+	// ALTERED: a delegate MakeDelegate couldn't complete is let go of (which releases the object and method it holds) and
+	// raises the exception below
+	if( delegate && !delegate->MakeDelegate(func, obj) )
+	{
+		delegate->Release();
+		delegate = 0;
+	}
+	if( delegate == 0 )
 	{
 		// ALTERED: with no memory for the delegate the script got a null handle with no exception, and found out only when it
 		// called it ("Null pointer access" there, or nothing for a callback a registered function skips when it is null).
@@ -195,7 +200,7 @@ asCScriptFunction *CreateDelegate(asCScriptFunction *func, void *obj)
 }
 
 // internal
-void asCScriptFunction::MakeDelegate(asCScriptFunction *func, void *obj)
+bool asCScriptFunction::MakeDelegate(asCScriptFunction *func, void *obj)
 {
 	// Increase the reference of the function and object
 	func->AddRef();
@@ -210,6 +215,12 @@ void asCScriptFunction::MakeDelegate(asCScriptFunction *func, void *obj)
 	returnType     = func->returnType;
 	inOutFlags     = func->inOutFlags;
 
+	// ALTERED: with no memory for the copies (a method with more than two parameters, beyond the arrays' own room) the delegate
+	// was left without parameters while its method takes them: a context prepared with it reserved no room for the arguments
+	// and refused to set them, and the method read them from past what it was given. The delegate is refused then.
+	if( parameterTypes.GetLength() != func->parameterTypes.GetLength() || inOutFlags.GetLength() != func->inOutFlags.GetLength() )
+		return false;
+
 	// The delegate doesn't own the parameters as it will only forward them to the real method
 	// so the exception handler must not clean up the parameters for the delegate
 	dontCleanUpOnException = true;
@@ -217,6 +228,7 @@ void asCScriptFunction::MakeDelegate(asCScriptFunction *func, void *obj)
 	// ALTERED: notify the GC of the delegate now that it is complete (the GC's lock publishes the writes above to the
 	// collecting thread); it was done in the constructor
 	engine->gc.AddScriptObjectToGC(this, &engine->functionBehaviours);
+	return true;
 }
 
 // interface
