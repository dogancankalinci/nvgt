+// ALTERED: a weak reference the destructor made to its own object (weakref<T>(this), or a lookup of the flag, as
+// CScriptWeakRef::Equals does) has a flag that didn't exist when Release or ReleaseByCollector decided that this was the last
+// reference, so nothing marked it dead: once the object was freed, the weak reference still took a reference to it (a use
+// after free in CScriptWeakRef::Get). The flag is marked here, under its lock as in Release, while this is still the only
+// reference. Returns false when the destructor stored a new reference to the object, which then stays alive with its weak
+// references: with release set the caller's reference is let go of under the lock and r is the count left, otherwise r is the
+// count and the collector keeps its reference. Returns true when the object can be destroyed.
+bool asCScriptObject::MarkWeakRefsMadeByDestructor(bool release, int &r) const
+{
+	asCLockableSharedBool *weakRefFlag = LoadWeakRefFlag();
+	if( weakRefFlag == 0 )
+		return true;
+
+	weakRefFlag->Lock();
+	if( !weakRefFlag->Get() )
+	{
+		if( refCount.get() != 1 )
+		{
+			r = release ? refCount.atomicDec() : int(refCount.get());
+			weakRefFlag->Unlock();
+			return false;
+		}
+		weakRefFlag->SetLocked(true);
+	}
+	weakRefFlag->Unlock();
+	return true;
+}
