+// ALTERED: the extra data and the weak reference flag are made under the global lock but read without it (here, and by Release
+// on any thread): they are published with release stores once made and read with acquire loads (see asStorePointerRelease),
+// so a reader that sees the pointer sees the flag's lock initialized. Plain stores and loads let a weak-memory CPU show the
+// pointer first.
+asCLockableSharedBool *asCScriptObject::LoadWeakRefFlag() const
+{
+	SExtra *e = reinterpret_cast<SExtra*>(asLoadPointerAcquire(reinterpret_cast<void *const *>(&extra)));
+	if( e == 0 )
+		return 0;
+	return reinterpret_cast<asCLockableSharedBool*>(asLoadPointerAcquire(reinterpret_cast<void *const *>(&e->weakRefFlag)));
+}
