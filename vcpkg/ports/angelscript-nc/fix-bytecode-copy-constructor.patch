+// ALTERED: whether a constructor or factory of the script class ot takes one object of the class by reference or handle,
+// which makes it the copy constructor (or copy factory) in asCBuilder::RegisterScriptFunction
+static bool IsCopyConstructorSignature(asCScriptFunction *func, asCObjectType *ot)
+{
+	return func->parameterTypes.GetLength() == 1 &&
+	       func->parameterTypes[0].GetTypeInfo() == ot &&
+	       (func->parameterTypes[0].IsReference() || func->parameterTypes[0].IsObjectHandle());
+}
