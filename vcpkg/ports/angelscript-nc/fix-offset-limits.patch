+// ALTERED: the bytecode refers to a variable or a parameter by a 16-bit offset from the stack frame (asBC_PSF, asBC_SetV4,
+// asBC_CpyVtoV4, ... take (short)offset), and to an argument by a 16-bit offset from the top of the stack (asBC_GETREF,
+// asBC_GETOBJ, asBC_ChkNullS take an asWORD), but nothing limited a function's variables, parameters or a call's arguments:
+// past 32767 dwords of variables (thousands of locals, or of value types kept on the stack), a parameter starting below
+// offset -32768 or an argument more than 65535 dwords from the top of the stack was read and written at a truncated offset,
+// in another one or outside the stack frame. Such a function or call is refused. Returns false when size is past the limit.
+bool asCCompiler::CheckOffsetLimit(int size, int limit, const char *msg, asCScriptNode *node)
+{
+	if( size <= limit )
+		return true;
+	if( node )
+		Error(msg, node);
+	else
+	{
+		builder->WriteError(script->name, msg, 0, 0);
+		hasCompileErrors = true;
+	}
+	return false;
+}
