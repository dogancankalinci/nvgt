--- a/sdk/angelscript/source/as_scriptengine.cpp
+++ b/sdk/angelscript/source/as_scriptengine.cpp
@@ -6102,12 +6102,27 @@ int asCScriptEngine::CallCopyBehaviour(void *dst, void *src, int funcId)
 {
 	asCScriptFunction *func = scriptFunctions[funcId];
 	asASSERT( func && func->funcType == asFUNC_SYSTEM && func->parameterTypes.GetLength() == 1 );
+	// ALTERED: the default opAssign of a script class (ScriptObject_Assignment) reports a failed copy (a member's opAssign
+	// raised an exception, see asCScriptObject::CopyFromAs) only by the exception it leaves in the active context, of which
+	// there may be none: the copy is made here as it makes it, by CopyFromAs, which returns the result
+	if( funcId == scriptTypeBehaviours.beh.copy )
+	{
+		asCScriptObject *dstObj = reinterpret_cast<asCScriptObject*>(dst);
+		return dstObj->CopyFromAs(reinterpret_cast<asCScriptObject*>(src), CastToObjectType(reinterpret_cast<asCTypeInfo*>(dstObj->GetObjectType()))) < 0 ? asERROR : asSUCCESS;
+	}
 	// ALTERED: not for an opAssign that returns a handle either (such as R@ opAssign(const R &in)), whose returned
 	// reference CallObjectMethod dropped, so every such assignment leaked one reference to the destination. The context
 	// releases the returned handle when it is unprepared.
 	if( func->parameterTypes[0].IsReference() && !func->DoesReturnOnStack() && !func->returnType.IsObjectHandle() )
 	{
+		// ALTERED: a registered opAssign reports a failure by raising a script exception in the active context (as the
+		// default opAssign of a script class does when a member's copy fails, see asCScriptObject::CopyFromAs), which is
+		// a failed copy here: it was reported as made, to AssignScriptObject's caller and to the copy of a class's members.
+		asIScriptContext *active = asGetActiveContext();
+		bool hadException = active && active->GetState() == asEXECUTION_EXCEPTION;
 		CallObjectMethod(dst, src, func->sysFuncIntf, func);
+		if( active && !hadException && active->GetState() == asEXECUTION_EXCEPTION )
+			return asERROR;
 		return asSUCCESS;
 	}
 
