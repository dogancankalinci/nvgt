+// ALTERED: the parser and the compiler recurse for each level of nesting, a few KB of native stack for each, and nothing limited it: source
+// a script compiles at run time could end the program with a stack overflow, which nothing can catch (300 nested constructor calls, 1000
+// parentheses or 2 KB of source on Windows' 1 MB stack). The limit is what the stack has left and not a number of levels, so that code
+// that compiled on a given thread goes on compiling, a chain of else if with thousands of branches on a thread with the stack for it.
+bool asIsStackNearlyFull()
+{
+	const size_t reserve = 128 * 1024; // Room for what a compilation does at the deepest level, and for reporting the error.
+
+#if defined(_WIN32) || defined(__linux__) || defined(__APPLE__)
+	static thread_local char *stackEnd = 0; // The lowest address of this thread's stack.
+	if( stackEnd == 0 )
+	{
+#if defined(_WIN32)
+		MEMORY_BASIC_INFORMATION info;
+		if( VirtualQuery(&info, &info, sizeof(info)) )
+			stackEnd = (char*)info.AllocationBase;
+#elif defined(__APPLE__)
+		pthread_t self = pthread_self();
+		stackEnd = (char*)pthread_get_stackaddr_np(self) - pthread_get_stacksize_np(self);
+#else
+		pthread_attr_t attr;
+		void *address = 0;
+		size_t size = 0;
+		if( pthread_getattr_np(pthread_self(), &attr) == 0 )
+		{
+			if( pthread_attr_getstack(&attr, &address, &size) == 0 )
+				stackEnd = (char*)address;
+			pthread_attr_destroy(&attr);
+		}
+#endif
+		if( stackEnd == 0 ) stackEnd = (char*)1; // Not known: this asks only once, and nothing is refused.
+	}
+	if( stackEnd == (char*)1 ) return false;
+#if defined(__GNUC__) || defined(__clang__)
+	char *here = (char*)__builtin_frame_address(0);
+#else
+	char marker;
+	char *here = &marker;
+#endif
+	return here < stackEnd + reserve;
+#else
+	return false;
+#endif
+}
+
+bool asCParser::CheckStack()
+{
+	if( isSyntaxError ) return true;
+	if( !asIsStackNearlyFull() ) return false;
+	sToken t;
+	GetToken(&t);
+	Error(TXT_CODE_NESTED_TOO_DEEPLY, &t);
+	return true;
+}
