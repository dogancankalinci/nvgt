+// ALTERED: whether a call to the function takes an object pointer from the stack above its arguments. A registered function
+// takes one as CallSystemFunction and CallGeneric pop it: by its calling convention, not by its object type (a template
+// instance's factory has the instance type as its object type but is a global function, and a method registered with
+// asCALL_THISCALL_ASGLOBAL is called on its auxiliary object).
+static bool TakesObjectPointer(asCScriptFunction *f)
+{
+	if( f->funcType != asFUNC_SYSTEM || f->sysFuncIntf == 0 )
+		return f->objectType != 0;
+	const internalCallConv cc = f->sysFuncIntf->callConv;
+	if( cc == ICC_GENERIC_METHOD || cc == ICC_GENERIC_METHOD_RETURNINMEM )
+		return true;
+	if( cc < ICC_THISCALL || cc == ICC_GENERIC_FUNC || cc == ICC_GENERIC_FUNC_RETURNINMEM )
+		return false;
+	return cc >= ICC_THISCALL_OBJLAST || f->sysFuncIntf->auxiliary == 0;
+}
