+// ALTERED: these two call the factories of registered types for CreateScriptObject, CreateScriptObjectCopy and the
+// members of an uninitialized script object. A factory declared to return an auto handle (T@+) adds no reference for
+// the object it returns, and the reference the caller then owns was never added, as CallSystemFunction (or CallGeneric,
+// in the default generic call mode) adds it when a script calls the factory: the object was destroyed while the factory
+// still held it once the caller released what it was given. The reference is added here the same way.
+void asCScriptEngine::AddRefAutoHandleReturn(void *ptr, asCScriptFunction *s) const
+{
+	if( ptr == 0 || !s->sysFuncIntf->returnAutoHandle )
+		return;
+	if( (s->sysFuncIntf->callConv == ICC_GENERIC_FUNC || s->sysFuncIntf->callConv == ICC_GENERIC_METHOD) && ep.genericCallMode != 1 )
+		return;
+	asCObjectType *ot = CastToObjectType(s->returnType.GetTypeInfo());
+	if( ot && ot->beh.addref )
+		CallObjectMethod(ptr, ot->beh.addref);
+}
+
