#include "form.nvgt"

tts_voice tts;
string speechbuff;
bool use_sr = true;
string voicename = "SR";
audio_form@ tts_config_form = null;
tts_voice@ tts_config_voice = null; // The voice the main configuration form configures.
tts_voice@ tts_config_preview = null; // The voice that speaks that form with its changes, see tts_config_speaker().
bool tts_default_interrupt = true;
funcdef string text_processing_callback(const string&in text);
text_processing_callback@ tts_default_text_processing_callback = null;
bool speak(string text, bool interrupt = tts_default_interrupt, text_processing_callback@ processing_callback = tts_default_text_processing_callback, bool braille = true) {
	speechbuff = text;
	if (@processing_callback != null) text = processing_callback(text);
	if (braille) screen_reader_braille(text);
	if (text.length() > 10000) {
		string tmp = text;
		while (tmp.length() > 0) {
			uint pos = 4096;
			while (pos > 2048 and pos < tmp.length() and tmp[pos] != " ") pos--;
			// Never inside a character: UTF-8 continuation bytes, 0x80 to 0xBF, are at most three.
			for (uint back = 0; back < 3 and pos < tmp.length() and tmp[pos] >= "\x80" and tmp[pos] < "\xC0"; back++) pos--;
			raw_speak(tmp.substr(0, pos), interrupt and tmp.length() == text.length());
			tmp = tmp.substr(pos);
		}
	} else
		raw_speak(text, interrupt);
	return true;
}
void raw_speak(string text, bool interrupt) {
	if (interrupt and tts.speaking) tts.stop();
	if (interrupt and @tts_config_preview != null and tts_config_preview.speaking) tts_config_preview.stop();
	tts_voice@ voice = tts;
	if (@tts_config_form != null) {
		use_sr = tts_config_form.is_checked(0);
		if (!use_sr or !screen_reader_has_speech()) @voice = tts_config_speaker(); // Whenever the tts voice is what speaks the form, so that its changes are heard.
	}
	// The voice speaks too when the screen reader turns the text down, as VoiceOver does while the game has no window in front.
	if (!use_sr or !screen_reader_has_speech() or !screen_reader_speak(text, interrupt))
		voice.speak(text, interrupt);
}
void stop_speech() {
	screen_reader_silence();
	tts.stop();
	if (@tts_config_preview != null) tts_config_preview.stop();
}
// The voice that speaks the main configuration form: the configured voice until the form's values first differ from its own, then a voice of its own that takes them, so that the configured voice changes only when the settings are saved and Cancel leaves it, settings it never had included, as it was. That voice starts as a copy of the configured one; it lists every engine's voices in every language, so voices are matched by name and language.
tts_voice@ tts_config_speaker() {
	tts_voice@ v = tts_config_voice;
	int voice = tts_config_form.get_list_position(1);
	double rate = tts_config_form.get_slider(2);
	double volume = tts_config_form.get_slider(3);
	if (@tts_config_preview == null) {
		if ((voice < 0 or voice == v.voice) and rate == v.rate and volume == v.volume) return v;
		tts_voice preview;
		if (v.voice > -1) preview.set_voice(tts_config_preview_voice(preview, v.voice));
		if (v.pitch_set) preview.pitch = v.pitch;
		if (v.rate_set) preview.rate = v.rate;
		if (v.volume_set) preview.volume = v.volume;
		@tts_config_preview = preview;
	}
	if (voice > -1) {
		int previewed = tts_config_preview_voice(tts_config_preview, voice);
		if (previewed > -1 and tts_config_preview.voice != previewed) tts_config_preview.set_voice(previewed);
	}
	if (tts_config_preview.rate != rate) tts_config_preview.set_rate(rate);
	if (tts_config_preview.volume != volume) tts_config_preview.set_volume(volume);
	return tts_config_preview;
}
// The preview's voice with the name and language of the configured voice's voice at the given index, or -1.
int tts_config_preview_voice(tts_voice@ preview, int voice) {
	string name = tts_config_voice.get_voice_name(voice), language = tts_config_voice.get_voice_language(voice);
	for (int i = 0; i < preview.voice_count; i++) {
		if (preview.get_voice_name(i) == name and preview.get_voice_language(i) == language) return i;
	}
	return -1;
}

// The voices' names as the user sees them: with the language added to a name another voice also has, as on Apple platforms, which list some voices once per language under one name.
string[] tts_voice_display_names(tts_voice@ v) {
	string[]@ names = v.list_voices();
	string[] shown = names;
	for (uint i = 0; i < names.length(); i++) {
		for (uint j = 0; j < names.length(); j++) {
			if (j == i or names[j] != names[i]) continue;
			shown[i] = names[i] + " (" + v.get_voice_language(i) + ")";
			break;
		}
	}
	return shown;
}
// A voice's name with its language, as it is saved, so that it is found again whichever other voices of that name are listed when loading.
string tts_voice_saved_name(tts_voice@ v, int voice) {
	string name = v.get_voice_name(voice), language = v.get_voice_language(voice);
	return language == ""? name : name + " (" + language + ")";
}
// Only what was set on the voice is written, "default" for the voice and an empty field for the rate or volume otherwise, so after loading the rest keep following the system's settings. The 0 stands for a pitch, which isn't saved.
string tts_dump_config(tts_voice@ v, bool save_screen_reader_setting = false) {
	string o = "default||";
	if (v.voice_set and v.voice > -1 and v.get_voice_name(v.voice) != "") o = tts_voice_saved_name(v, v.voice) + "||"; // Not the list of every voice, which binds every engine.
	o += (v.rate_set? "" + v.rate : "") + "||0||" + (v.volume_set? "" + v.volume : "");
	if (save_screen_reader_setting) o += "||" + (use_sr? "1" : "0");
	return o;
}
// A rate or volume as tts_dump_config writes it, such as "-2.5". Anything else in the field, from a damaged or edited string, leaves the setting as it was, as an empty field does, rather than reading as 0.
bool tts_config_number(string s) {
	if (s.substr(0, 1) == "-") s = s.substr(1);
	int point = s.find(".");
	string whole = point < 0? s : s.substr(0, point), fraction = point < 0? "" : s.substr(point + 1);
	return (whole != "" or fraction != "") and (whole == "" or whole.is_digits()) and (fraction == "" or fraction.is_digits());
}
bool tts_load_config(string c, tts_voice@ v) {
	string[] args = c.split("||", true, true); // Keeping the empty fields of settings that weren't saved.
	if (args.length() < 4) return false;
	if (args[0] != "default") {
		string[]@ names = v.list_voices();
		int i = -1;
		for (uint j = 0; j < names.length() and i < 0; j++) { // Asking for the language only of the voices whose name the saved one starts with.
			if (names[j] != "" and args[0].find(names[j]) == 0 and tts_voice_saved_name(v, j) == args[0]) i = j;
		}
		if (i < 0) i = names.find(args[0]); // Saved with the plain name, before the language was always saved.
		if (i > -1) v.set_voice(i);
	}
	if (tts_config_number(args[1])) v.set_rate(parse_float(args[1]));
	if (tts_config_number(args[3])) v.set_volume(parse_float(args[3]));
	if (args.length() > 4 and (args[4] == "0" or args[4] == "1")) use_sr = args[4] == "1";
	return true;
}

void tts_config(tts_voice@ v, bool main_config = false) {
	bool orig_sr = use_sr;
	audio_form f;
	f.create_window("Text to speech configuration", false, true);
	int f_use_sr = f.create_checkbox("use screen reader when available", main_config and use_sr);
	if (!main_config)
		f.set_state(f_use_sr, true, main_config);
	int f_voices = f.create_list("Voice");
	int f_rate = f.create_slider("Rate", v.rate, -10, 10);
	int f_volume = f.create_slider("Volume", v.volume, -100, 0);
	double initial_rate = f.get_slider(f_rate), initial_volume = f.get_slider(f_volume);
	int f_save = f.create_button("&Save settings", true);
	int f_cancel = f.create_button("Cancel", false, true);
	string[] voicenames = tts_voice_display_names(v);
	// Nothing is selected until the user picks a voice when the voice can't say which one it speaks with, so that neither Save nor the form's own speech switches to the first one.
	for (uint i = 0; i < voicenames.length(); i++)
		f.add_list_item(f_voices, voicenames[i] != "" ? voicenames[i] : "Unknown voice " + (i + 1), -1, false, false);
	if (v.voice > -1)
		f.set_list_position(f_voices, v.voice);
	f.focus(main_config ? 0 : 1);
	if (main_config) {
		@tts_config_voice = v;
		@tts_config_form = @f;
	}
	while (true) {
		wait(5);
		f.monitor();
		if (f.is_pressed(f_cancel)) {
			tts_config_close();
			use_sr = orig_sr;
			speak("Canceled");
			break;
		} else if (f.is_pressed(f_save)) {
			tts_config_close();
			// Only what was changed, so the rest keeps following the system's settings. The sliders are compared with where they started, as a voice of another engine reports that engine's own rate and volume once selected.
			int voice = f.get_list_position(f_voices);
			if (voice > -1 and voice != v.voice) v.set_voice(voice);
			if (f.get_slider(f_rate) != initial_rate) v.set_rate(f.get_slider(f_rate));
			if (f.get_slider(f_volume) != initial_volume) v.set_volume(f.get_slider(f_volume));
			speak("Text to speech settings saved");
			break;
		}
	}
	tts_config_close();
}
// Ends the main configuration form's speech through a voice of its own, letting that voice go, which also stops what it was saying.
void tts_config_close() {
	@tts_config_form = null;
	@tts_config_preview = null;
	@tts_config_voice = null;
}
